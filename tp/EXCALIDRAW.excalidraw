      "isDeleted": false,
      "boundElements": [],
      "updated": 1791485288133,
      "created": 1791485145730,
      "link": null,
      "locked": false,
      "text": "1) Estado vive en 1 agent, todos contra ese agent\n\n2) Estado particionado, cada agent es dueño de una porción de datos\n\n3) Estado actualizado por evento a las réplicas tipo topic / broadcast",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Estado vive en 1 agent, todos contra ese agent\n\n2) Estado particionado, cada agent es dueño de una porción de datos\n\n3) Estado actualizado por evento a las réplicas tipo topic / broadcast",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
