    {
      "id": "qUx8EWplyhbmyX9Zoe718",
      "type": "text",
      "x": 5695.7510356044295,
      "y": 465.632222508925,
      "width": 800,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 372917658,
      "version": 97,
      "versionNonce": 19993114,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791485537658,
      "created": 1791485523728,
      "link": null,
      "locked": false,
      "text": "Por convención, las funciones devuelven tuplas que empiezan con un átomo que\nindica el resultado: \n\n    {:ok, valor} si salió bien, \n    {:error, motivo} si no. \n\nLos callbacks de GenServer también devuelven tuplas ({:reply, ...}, {:noreply, ...},\n{:stop, ...}) que OTP lee para saber qué hacer.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por convención, las funciones devuelven tuplas que empiezan con un átomo que indica el resultado: \n\n    {:ok, valor} si salió bien, \n    {:error, motivo} si no. \n\nLos callbacks de GenServer también devuelven tuplas ({:reply, ...}, {:noreply, ...}, {:stop, ...}) que OTP lee para saber qué hacer.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
