    {
      "id": "Ffa5efUWkpyxKUghxV_HU",
      "type": "text",
      "x": 403.6754341869002,
      "y": 5161.447528928543,
      "width": 1094.8192138671875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2A",
      "roundness": null,
      "seed": 1994591155,
      "version": 330,
      "versionNonce": 2023212573,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795476153345,
      "link": null,
      "locked": false,
      "text": "Sirve para abstraerse de resultados intermedios, no se chequea en cada paso, se aplica en orden y se ve al final.\n\nSirve cuando el paso siguiente depende del valor obtenido en el anterior.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sirve para abstraerse de resultados intermedios, no se chequea en cada paso, se aplica en orden y se ve al final.\n\nSirve cuando el paso siguiente depende del valor obtenido en el anterior.",
      "autoResize": true,
      "lineHeight": 1.25
    },
