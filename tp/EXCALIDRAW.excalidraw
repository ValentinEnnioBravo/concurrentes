      "labelPosition": null
    },
    {
      "id": "wYj9DoUQSe5807aSmu1nj",
      "type": "text",
      "x": 4797.239682052389,
      "y": 710.0495014082555,
      "width": 694.9794921875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
