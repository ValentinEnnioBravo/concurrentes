    {
      "id": "sHjjXWQD2voXCFaZ3B-PU",
      "type": "text",
      "x": 2062.750772854903,
      "y": 92.9784449110152,
      "width": 445.47967529296875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
