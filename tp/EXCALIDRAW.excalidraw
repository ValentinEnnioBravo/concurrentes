      "labelPosition": null
    },
    {
      "id": "wYj9DoUQSe5807aSmu1nj",
      "type": "text",
      "x": 3321.544796798483,
      "y": 8678.799501408255,
      "width": 694.9794921875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
