    {
      "id": "gv1gxc886",
      "type": "text",
      "x": 0,
      "y": 718,
      "width": 1142.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
