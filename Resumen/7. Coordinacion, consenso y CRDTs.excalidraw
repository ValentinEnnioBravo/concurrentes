    },
    {
      "id": "g14gh7n1pb",
      "type": "text",
      "x": 18,
      "y": 3447.5,
      "width": 473.76000000000005,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1457,
      "version": 2,
      "versionNonce": 1891436433,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795562496393,
      "link": null,
      "locked": false,
      "text": "Con UN SOLO NO se aborta. El coordinador manda\nABORT a todos y cada participante DESCARTA lo\npreparado (rollback): no cambia NADA. La\ntransacción se CANCELA; el protocolo NO la\nreintenta. Si se quiere, el cliente la manda de\nnuevo como una transacción nueva.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con UN SOLO NO se aborta. El coordinador manda\nABORT a todos y cada participante DESCARTA lo\npreparado (rollback): no cambia NADA. La\ntransacción se CANCELA; el protocolo NO la\nreintenta. Si se quiere, el cliente la manda de\nnuevo como una transacción nueva.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1S"
    },
