      "isDeleted": false,
      "boundElements": [],
      "updated": 1795562496393,
      "link": null,
      "locked": false,
      "text": "Regla: para tolerar f traidores hacen falta n ≥ 3f + 1 nodos (menos de ⅓ traidores). Con 3 nodos y\n1 traidor NO hay consenso posible.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Regla: para tolerar f traidores hacen falta n ≥ 3f + 1 nodos (menos de ⅓ traidores). Con 3 nodos y\n1 traidor NO hay consenso posible.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "af"
