    {
      "id": "g12vnzrz8c",
      "type": "text",
      "x": 0,
      "y": 2888,
      "width": 1142.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1400,
      "version": 2,
      "versionNonce": 1623443647,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795562496393,
      "link": null,
      "locked": false,
      "text": "Un COORDINADOR le pregunta a los PARTICIPANTES (los nodos con los datos) si pueden hacer su parte de\nuna TRANSACCIÓN. Es ATÓMICO: o se aplica en TODOS o en NINGUNO. Hasta que no hay commit, no pasó nada.\nSe usa en bases de datos distribuidas.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un COORDINADOR le pregunta a los PARTICIPANTES (los nodos con los datos) si pueden hacer su parte de\nuna TRANSACCIÓN. Es ATÓMICO: o se aplica en TODOS o en NINGUNO. Hasta que no hay commit, no pasó nada.\nSe usa en bases de datos distribuidas.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b19"
    },
