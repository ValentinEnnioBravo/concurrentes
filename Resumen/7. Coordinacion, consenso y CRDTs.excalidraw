    },
    {
      "id": "g14pvmr2zz",
      "type": "text",
      "x": 618,
      "y": 3447.5,
      "width": 504.00000000000006,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1466,
      "version": 2,
      "versionNonce": 2115804703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795562496393,
      "link": null,
      "locked": false,
      "text": "Igual que 2PC: un NO (o un TIMEOUT) en la votación\n→ ABORT a todos y no cambia nada. Lo nuevo: si el\ncoordinador se cae, nadie espera para siempre. Sin\npre-commit → abortan por timeout; si ya recibieron\nel pre-commit → commitean.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Igual que 2PC: un NO (o un TIMEOUT) en la votación\n→ ABORT a todos y no cambia nada. Lo nuevo: si el\ncoordinador se cae, nadie espera para siempre. Sin\npre-commit → abortan por timeout; si ya recibieron\nel pre-commit → commitean.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1V"
    },
