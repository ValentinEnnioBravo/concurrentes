    {
      "id": "g1isjmbb0m",
      "type": "text",
      "x": 25,
      "y": 6955.5,
      "width": 1041.6000000000001,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
