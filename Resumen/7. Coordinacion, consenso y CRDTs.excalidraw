      "link": null,
      "locked": false,
      "text": "Abort",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Abort",
      "autoResize": true,
