    },
    {
      "id": "g1ja7tx5jg",
      "type": "text",
      "x": 0,
      "y": 7225.5,
      "width": 1153.6000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1991,
      "version": 2,
      "versionNonce": 140059249,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795562496393,
      "link": null,
      "locked": false,
      "text": "Si el contador fuera un solo número, A suma 1 y B suma 1, cada uno tiene 1... ¿el merge da 1 o 2? No se\nsabe. Solución: cada nodo lleva SU PROPIO casillero y solo suma en el suyo.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si el contador fuera un solo número, A suma 1 y B suma 1, cada uno tiene 1... ¿el merge da 1 o 2? No se\nsabe. Solución: cada nodo lleva SU PROPIO casillero y solo suma en el suyo.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4K"
    },
