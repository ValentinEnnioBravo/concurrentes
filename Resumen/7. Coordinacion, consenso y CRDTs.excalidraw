      "text": "CRDT",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "g1ivu12i7j",
      "originalText": "CRDT",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4G"
    },
    {
      "id": "g1j1lfv7wf",
      "type": "text",
      "x": 0,
      "y": 7075.5,
      "width": 1142.4,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1982,
      "version": 2,
      "versionNonce": 1379902687,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795562496393,
      "link": null,
      "locked": false,
      "text": "CRDT (Conflict-free Replicated Data Type) = una ESTRUCTURA DE DATOS que trae su propia regla de MERGE.\nCada nodo escribe en SU copia sin preguntarle a nadie (sin líder, sin votación). Cuando dos copias se\njuntan, se aplica el merge. La regla está diseñada para que el resultado sea el MISMO sin importar el\nORDEN en que lleguen los cambios ni si llegan REPETIDOS (merge conmutativo, asociativo e idempotente).\nResultado: cuando todos recibieron todo, todos ven LO MISMO (consistencia eventual).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CRDT (Conflict-free Replicated Data Type) = una ESTRUCTURA DE DATOS que trae su propia regla de MERGE.\nCada nodo escribe en SU copia sin preguntarle a nadie (sin líder, sin votación). Cuando dos copias se\njuntan, se aplica el merge. La regla está diseñada para que el resultado sea el MISMO sin importar el\nORDEN en que lleguen los cambios ni si llegan REPETIDOS (merge conmutativo, asociativo e idempotente).\nResultado: cuando todos recibieron todo, todos ven LO MISMO (consistencia eventual).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4H"
    },
    {
      "id": "g1j4szhabl",
      "type": "rectangle",
