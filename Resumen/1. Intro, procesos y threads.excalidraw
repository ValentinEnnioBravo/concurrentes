      "roundness": null,
      "seed": 1805,
      "version": 2,
      "versionNonce": 307409286,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795614845971,
      "link": null,
      "locked": false,
      "text": "¿Qué dan los procesos que no dan los threads, y viceversa?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
