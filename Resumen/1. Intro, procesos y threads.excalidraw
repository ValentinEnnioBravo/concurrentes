    {
      "id": "g1uy3zbkyw",
      "type": "text",
      "x": 25,
      "y": 7558,
      "width": 1097.6000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
