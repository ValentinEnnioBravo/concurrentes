      "link": null,
      "locked": false,
      "text": "El GIL NO garantiza thread-safety: el cambio de contexto puede caer en medio de una sección\ncrítica. Evita el paralelismo, no las condiciones de carrera.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El GIL NO garantiza thread-safety: el cambio de contexto puede caer en medio de una sección\ncrítica. Evita el paralelismo, no las condiciones de carrera.",
      "autoResize": true,
      "lineHeight": 1.25
    },
