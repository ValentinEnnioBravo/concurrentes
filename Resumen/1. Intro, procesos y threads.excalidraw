      "isDeleted": false,
      "boundElements": [],
      "updated": 1795614845971,
      "link": null,
      "locked": false,
      "text": "3 requests, cada uno: 1 de CPU + 3 de I/O + 1 de CPU (5 unidades). En MRI la CPU necesita el GIL;\ndurante la I/O el GIL queda libre.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3 requests, cada uno: 1 de CPU + 3 de I/O + 1 de CPU (5 unidades). En MRI la CPU necesita el GIL;\ndurante la I/O el GIL queda libre.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6d"
    },
