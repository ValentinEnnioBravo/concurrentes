      "text": "Sí: los contextos se alternan con cambios de\ncontexto. Hay concurrencia sin paralelismo.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sí: los contextos se alternan con cambios de\ncontexto. Hay concurrencia sin paralelismo.",
