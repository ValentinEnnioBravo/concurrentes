      "versionNonce": 2256,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "t = threads por worker, w = workers. Paralelismo de CPU = w × (1 en MRI, t en JRuby), con tope en los\nnúcleos. Concurrencia de I/O = w × t.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "t = threads por worker, w = workers. Paralelismo de CPU = w × (1 en MRI, t en JRuby), con tope en los\nnúcleos. Concurrencia de I/O = w × t.",
      "autoResize": true,
      "lineHeight": 1.25
    },
