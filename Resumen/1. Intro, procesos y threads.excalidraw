    {
      "id": "g19dngga17",
      "type": "text",
      "x": 414.6666666666667,
      "y": 3788.75,
      "width": 322.56000000000006,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
