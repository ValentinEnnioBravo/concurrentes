      "text": "¿Puede haber concurrencia en una máquina de un solo núcleo?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Puede haber concurrencia en una máquina de un solo núcleo?",
