    },
    {
      "id": "g1e1ym3wur",
      "type": "text",
      "x": 0,
      "y": 4478,
      "width": 1153.6000000000001,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1802,
      "version": 2,
      "versionNonce": 440616218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795614845971,
      "link": null,
      "locked": false,
      "text": "Un thread por tarea es caro. Un EXECUTOR reparte las tareas entre un POOL ACOTADO de threads que se\nreutilizan; si están todos ocupados, las tareas esperan en cola. BULKHEAD (compartimentos de un barco):\nun pool POR DEPENDENCIA (uno para la API externa lenta, otro para la base) → si una se satura, no tumba\na las demás.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un thread por tarea es caro. Un EXECUTOR reparte las tareas entre un POOL ACOTADO de threads que se\nreutilizan; si están todos ocupados, las tareas esperan en cola. BULKHEAD (compartimentos de un barco):\nun pool POR DEPENDENCIA (uno para la API externa lenta, otro para la base) → si una se satura, no tumba\na las demás.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b3J"
    },
    {
      "id": "g1e4uzel11",
      "type": "text",
      "x": 20,
      "y": 4603,
      "width": 649.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
