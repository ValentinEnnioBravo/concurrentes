    {
      "id": "g1v7w4mdds",
      "type": "text",
      "x": 0,
      "y": 7653,
      "width": 1086.4,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2420,
      "version": 1,
      "versionNonce": 2421,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "3 requests, cada uno: 1 de CPU + 3 de I/O + 1 de CPU (5 unidades). En MRI la CPU necesita el GIL;\ndurante la I/O el GIL queda libre.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3 requests, cada uno: 1 de CPU + 3 de I/O + 1 de CPU (5 unidades). En MRI la CPU necesita el GIL;\ndurante la I/O el GIL queda libre.",
      "autoResize": true,
      "lineHeight": 1.25
    },
