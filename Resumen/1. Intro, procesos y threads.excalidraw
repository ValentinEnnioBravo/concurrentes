      "link": null,
      "locked": false,
      "text": "# MAL: get y set sincronizados por separado → el cambio puede caer entre ambos\n# BIEN: un solo mutex que abarca TODA la sección crítica\n@lock.synchronize { @likes = @likes + 1 }",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# MAL: get y set sincronizados por separado → el cambio puede caer entre ambos\n# BIEN: un solo mutex que abarca TODA la sección crítica\n@lock.synchronize { @likes = @likes + 1 }",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b52"
    },
