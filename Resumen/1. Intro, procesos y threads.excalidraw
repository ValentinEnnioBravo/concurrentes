    {
      "id": "g1gvm3fhq8",
      "type": "text",
      "x": 0,
      "y": 5285.5,
      "width": 616.0000000000001,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
