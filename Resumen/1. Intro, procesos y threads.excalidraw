    {
      "id": "g1mjirllvu",
      "type": "text",
      "x": 25,
      "y": 6058,
      "width": 1097.6000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
