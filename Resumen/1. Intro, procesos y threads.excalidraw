      "boundElements": [],
      "updated": 1795614845971,
      "link": null,
      "locked": false,
      "text": "Paralelismo NO implica concurrencia y concurrencia NO implica paralelismo. El problema es SIEMPRE\nla concurrencia: no se garantiza el orden de ejecución y, por lo tanto, tampoco el resultado.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Paralelismo NO implica concurrencia y concurrencia NO implica paralelismo. El problema es SIEMPRE\nla concurrencia: no se garantiza el orden de ejecución y, por lo tanto, tampoco el resultado.",
