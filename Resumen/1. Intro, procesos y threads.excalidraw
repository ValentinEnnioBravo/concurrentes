    {
      "id": "g194g5ri1i",
      "type": "text",
      "x": 18,
      "y": 3788.75,
      "width": 322.56000000000006,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
