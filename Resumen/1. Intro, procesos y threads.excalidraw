      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Suspender una tarea conserva su continuación y LIBERA el thread; bloquear un thread impide que haga\ncualquier otra cosa. → ¿Muchísima I/O con UN SOLO THREAD, sin locks? Event loop y corrutinas (clase\n2).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suspender una tarea conserva su continuación y LIBERA el thread; bloquear un thread impide que haga\ncualquier otra cosa. → ¿Muchísima I/O con UN SOLO THREAD, sin locks? Event loop y corrutinas (clase\n2).",
      "autoResize": true,
      "lineHeight": 1.25
    },
