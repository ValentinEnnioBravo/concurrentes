      "locked": false,
      "index": "b4i"
    },
    {
      "id": "d11dzoqe19",
      "type": "text",
      "x": 1260,
      "y": 8215.5,
      "width": 453.6,
      "height": 45,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1346,
      "version": 2,
      "versionNonce": 337819915,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175413,
      "link": null,
      "locked": false,
      "text": "No. Los levantás vos; libcluster corre dentro\nde cada uno y hace el Node.connect.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
