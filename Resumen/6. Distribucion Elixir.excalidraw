      "roundness": null,
      "seed": 1283,
      "version": 1,
      "versionNonce": 1284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿La cookie protege el tráfico entre nodos?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
