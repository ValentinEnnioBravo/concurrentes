      "locked": false
    },
    {
      "id": "dxphbiyy9",
      "type": "text",
      "x": 25,
      "y": 1545.5,
      "width": 1041.6000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1214,
      "version": 1,
      "versionNonce": 1215,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Límite: el nodo nuevo tiene que saber DE ANTEMANO a quién conectarse. Si los nodos que conoce\nestán caídos, no tiene por dónde entrar.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Límite: el nodo nuevo tiene que saber DE ANTEMANO a quién conectarse. Si los nodos que conoce\nestán caídos, no tiene por dónde entrar.",
      "autoResize": true,
      "lineHeight": 1.25
