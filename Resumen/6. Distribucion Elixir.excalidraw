      "versionNonce": 1335,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Sin ACK: los paquetes SE PUEDEN PERDER\n(y no hay orden garantizado).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sin ACK: los paquetes SE PUEDEN PERDER\n(y no hay orden garantizado).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "d1140enjok",
      "type": "text",
      "x": 0,
      "y": 8115.5,
      "width": 1120,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1337,
      "version": 1,
      "versionNonce": 1338,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Si el heartbeat viaja por algo que pierde paquetes, en una red con problemas se pueden perder varios\nseguidos y el cluster CREE que un nodo se cayó cuando no se cayó (FALSO NEGATIVO).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si el heartbeat viaja por algo que pierde paquetes, en una red con problemas se pueden perder varios\nseguidos y el cluster CREE que un nodo se cayó cuando no se cayó (FALSO NEGATIVO).",
      "autoResize": true,
      "lineHeight": 1.25
    },
