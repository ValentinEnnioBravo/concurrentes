      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "Nodo = una instancia de la VM de Erlang (BEAM) corriendo. Cada iex que abrís es un nodo.\nNo es necesariamente un servidor web: es solo una VM.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nodo = una instancia de la VM de Erlang (BEAM) corriendo. Cada iex que abrís es un nodo.\nNo es necesariamente un servidor web: es solo una VM.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aR"
    },
