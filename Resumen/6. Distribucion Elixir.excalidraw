    },
    {
      "id": "d18jvyo1h2",
      "type": "text",
      "x": 25,
      "y": 9924.5,
      "width": 1097.6000000000001,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1604,
      "version": 2,
      "versionNonce": 500328939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175414,
      "link": null,
      "locked": false,
      "text": "Sincronización con (delta-)CRDTs: cada nodo tiene SU COPIA, la modifica localmente y las copias se\nmezclan (merge) sin conflictos → CONSISTENCIA EVENTUAL. Delta = manda solo los cambios, no todo.\n→ Lo vemos en detalle en el apunte de CRDTs.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sincronización con (delta-)CRDTs: cada nodo tiene SU COPIA, la modifica localmente y las copias se\nmezclan (merge) sin conflictos → CONSISTENCIA EVENTUAL. Delta = manda solo los cambios, no todo.\n→ Lo vemos en detalle en el apunte de CRDTs.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b67"
    },
