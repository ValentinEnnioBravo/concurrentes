      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Darle nombre (sin nombre = :nonode@nohost → no se conecta con nadie)",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Darle nombre (sin nombre = :nonode@nohost → no se conecta con nadie)",
