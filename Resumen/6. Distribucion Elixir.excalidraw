    {
      "id": "dzathw32m",
      "type": "text",
      "x": 610,
      "y": 1888,
      "width": 451.2,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1271,
      "version": 2,
      "versionNonce": 1231948869,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "iex --sname a --cookie secreto\niex --sname c --cookie otra_cosa\n\n# en c:\nNode.connect(:a@altair)    # false\n# en a: \"Invalid challenge reply\"\nNode.get_cookie()          # :otra_cosa\nNode.set_cookie(:secreto)  # cambio en caliente\nNode.connect(:a@altair)    # true",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "iex --sname a --cookie secreto\niex --sname c --cookie otra_cosa\n\n# en c:\nNode.connect(:a@altair)    # false\n# en a: \"Invalid challenge reply\"\nNode.get_cookie()          # :otra_cosa\nNode.set_cookie(:secreto)  # cambio en caliente\nNode.connect(:a@altair)    # true",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0S"
    },
    {
      "id": "dzdtmvec5",
      "type": "text",
      "x": 0,
      "y": 2143,
      "width": 1120,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1274,
      "version": 2,
      "versionNonce": 1434158731,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "Cómo funciona: al conectarse hay un CHALLENGE (\"¿tenés la misma cookie que yo?\"). Si no coincide,\nla conexión se rechaza.\n• Sin --cookie → Erlang usa la de ~/.erlang.cookie (valor al azar generado la 1ª vez). Por eso en tu\n  máquina dos nodos sin cookie se conectan: los dos leen el mismo archivo.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cómo funciona: al conectarse hay un CHALLENGE (\"¿tenés la misma cookie que yo?\"). Si no coincide,\nla conexión se rechaza.\n• Sin --cookie → Erlang usa la de ~/.erlang.cookie (valor al azar generado la 1ª vez). Por eso en tu\n  máquina dos nodos sin cookie se conectan: los dos leen el mismo archivo.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0T"
    },
    {
      "id": "dzgq2wwze",
