    {
      "id": "dsa2e8tlt",
      "type": "text",
      "x": 25,
      "y": 6088.5,
      "width": 1052.8000000000002,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
