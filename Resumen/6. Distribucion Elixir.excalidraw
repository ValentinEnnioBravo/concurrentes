      "versionNonce": 219502181,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "No. Solo evita que se conecten nodos de\nclusters distintos; la conexión no va encriptada.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No. Solo evita que se conecten nodos de\nclusters distintos; la conexión no va encriptada.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0Y"
    },
