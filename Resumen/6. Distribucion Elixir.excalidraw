      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Cada paquete tiene ACK; si no llega se\nRETRANSMITE. Garantiza llegada y orden.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cada paquete tiene ACK; si no llega se\nRETRANSMITE. Garantiza llegada y orden.",
      "autoResize": true,
      "lineHeight": 1.25
    },
