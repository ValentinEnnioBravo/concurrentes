    {
      "id": "d1hjn55a3d",
      "type": "text",
      "x": 0,
      "y": 12588,
      "width": 1075.2,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
