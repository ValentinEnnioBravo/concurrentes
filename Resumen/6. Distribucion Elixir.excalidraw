    {
      "id": "d15s54z419",
      "type": "text",
      "x": 0,
      "y": 9379.5,
      "width": 1120,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
