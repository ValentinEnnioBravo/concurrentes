      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "iex --sname a          # nombre CORTO → a@altair (altair = hostname)\niex --name a@127.0.0.1 # nombre LARGO → IP o dominio (otras máquinas)\n\nNode.self()            # :a@altair → quién soy\nNode.list()            # []        → con quién estoy conectado (sin mí)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "iex --sname a          # nombre CORTO → a@altair (altair = hostname)\niex --name a@127.0.0.1 # nombre LARGO → IP o dominio (otras máquinas)\n\nNode.self()            # :a@altair → quién soy\nNode.list()            # []        → con quién estoy conectado (sin mí)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aU"
