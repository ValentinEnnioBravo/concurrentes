      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "¿La cookie protege el tráfico entre nodos?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿La cookie protege el tráfico entre nodos?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0W"
    },
    {
      "id": "dzpdvi388",
      "type": "rectangle",
      "x": 1240,
