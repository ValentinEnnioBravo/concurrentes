      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175413,
      "link": null,
      "locked": false,
      "text": "¿Diferencia entre GenServer.call(PingPong, :ping) y\nGenServer.call({PingPong, :a@altair}, :ping)?",
