    {
      "id": "dsp7qy5jn",
      "type": "text",
      "x": 20,
      "y": 6348.5,
      "width": 604.8,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
