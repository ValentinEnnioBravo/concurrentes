      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175413,
      "link": null,
      "locked": false,
      "text": "Un PID identifica a un proceso en TODO el cluster: lo podés guardar y mandarle send/call/cast igual.\nEl 1er número lo asigna la VM al conectarse: no es fijo ni predecible.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un PID identifica a un proceso en TODO el cluster: lo podés guardar y mandarle send/call/cast igual.\nEl 1er número lo asigna la VM al conectarse: no es fijo ni predecible.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b2f"
    },
