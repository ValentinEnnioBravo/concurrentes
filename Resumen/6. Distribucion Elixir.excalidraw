      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "Distribución = repartir procesos entre varios nodos y que puedan hablar entre sí como si estuvieran\nen el mismo lado.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Distribución = repartir procesos entre varios nodos y que puedan hablar entre sí como si estuvieran\nen el mismo lado.",
