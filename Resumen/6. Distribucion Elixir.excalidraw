      "boundElements": [],
      "updated": 1795639175414,
      "link": null,
      "locked": false,
      "text": "El nombre de Horde NO es un lock global: durante una partición cada lado tiene su vista y, según la\nestrategia, LOS DOS LADOS pueden correr una instancia del mismo proceso. Al reunirse, el registry\nresuelve el conflicto.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El nombre de Horde NO es un lock global: durante una partición cada lado tiene su vista y, según la\nestrategia, LOS DOS LADOS pueden correr una instancia del mismo proceso. Al reunirse, el registry\nresuelve el conflicto.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b94"
    },
    {
      "id": "d1nvzwvbdu",
      "type": "text",
      "x": 0,
      "y": 14241.5,
      "width": 1108.8000000000002,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
