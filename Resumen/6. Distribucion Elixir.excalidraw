      "versionNonce": 1035,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "topologies = [\n  myapp: [strategy: Cluster.Strategy.Epmd,\n          config: [hosts: [:\"a@127.0.0.1\"]]]  # ≥ 1 conocido\n]\nchildren = [\n  {Cluster.Supervisor, [topologies, [name: MyApp.ClusterSup]]},\n  ...  # el resto de tus supervisores\n]",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "topologies = [\n  myapp: [strategy: Cluster.Strategy.Epmd,\n          config: [hosts: [:\"a@127.0.0.1\"]]]  # ≥ 1 conocido\n]\nchildren = [\n  {Cluster.Supervisor, [topologies, [name: MyApp.ClusterSup]]},\n  ...  # el resto de tus supervisores\n]",
      "autoResize": true,
      "lineHeight": 1.25
    },
