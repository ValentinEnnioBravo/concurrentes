    {
      "id": "dzseqokgm",
      "type": "text",
      "x": 1260,
      "y": 2423,
      "width": 493.9200000000001,
      "height": 45,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
