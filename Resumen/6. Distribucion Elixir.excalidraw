      "boundElements": [],
      "updated": 1795639175413,
      "link": null,
      "locked": false,
      "text": "Se corta la red unos segundos y vuelve.\n¿Los nodos siguen conectados?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se corta la red unos segundos y vuelve.\n¿Los nodos siguen conectados?",
