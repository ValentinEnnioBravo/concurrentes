    {
      "id": "d1ns1qhoop",
      "type": "text",
      "x": 25,
      "y": 14121.5,
      "width": 1108.8000000000002,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
