      "index": "b0U"
    },
    {
      "id": "dzjmj51tq",
      "type": "text",
      "x": 25,
      "y": 2283,
      "width": 1052.8000000000002,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1280,
      "version": 2,
      "versionNonce": 1358986539,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795639175412,
      "link": null,
      "locked": false,
      "text": "NO es seguridad real: sirve para NO MEZCLAR CLUSTERS (que un nodo de \"pepito\" no se\nconecte por error a \"juancito\"). La conexión no va encriptada. La seguridad se pone ALREDEDOR:\nred privada, VPN, firewall.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NO es seguridad real: sirve para NO MEZCLAR CLUSTERS (que un nodo de \"pepito\" no se\nconecte por error a \"juancito\"). La conexión no va encriptada. La seguridad se pone ALREDEDOR:\nred privada, VPN, firewall.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0V"
    },
    {
      "id": "dzmpveq7b",
      "type": "text",
      "x": 20,
      "y": 2413,
      "width": 470.40000000000003,
      "height": 25,
