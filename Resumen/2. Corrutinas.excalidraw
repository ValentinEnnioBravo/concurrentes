      "seed": 1722851348,
      "version": 1,
      "versionNonce": 1623616120,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "def fetch(url):\n    sock = socket.socket()\n    sock.connect(('bla.com', 80))   # BLOQUEA hasta conectar\n    sock.send(request.encode('ascii'))\n    chunk = sock.recv(4096)         # BLOQUEA hasta que lleguen datos\n    while chunk:\n        response += chunk\n        chunk = sock.recv(4096)\n    parse_response(response)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def fetch(url):\n    sock = socket.socket()\n    sock.connect(('bla.com', 80))   # BLOQUEA hasta conectar\n    sock.send(request.encode('ascii'))\n    chunk = sock.recv(4096)         # BLOQUEA hasta que lleguen datos\n    while chunk:\n        response += chunk\n        chunk = sock.recv(4096)\n    parse_response(response)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aX"
    },
