    {
      "id": "th66cmfg356c",
      "type": "text",
      "x": 40,
      "y": 6044.25,
      "width": 691.1999999999999,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2126499717,
      "version": 1,
      "versionNonce": 761009270,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "// Sincrónico: ~6 s para 6 hashes, el loop queda congelado\npbkdf2Sync('pwd', 'salt', 100000, 512, 'sha512');\n\n// Asincrónico: ~3 s, se delega a los worker threads de libuv\nprocess.env.UV_THREADPOOL_SIZE = 6;\npbkdf2('pwd', 'salt', 100000, 512, 'sha512', () => console.log('Done'));",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Sincrónico: ~6 s para 6 hashes, el loop queda congelado\npbkdf2Sync('pwd', 'salt', 100000, 512, 'sha512');\n\n// Asincrónico: ~3 s, se delega a los worker threads de libuv\nprocess.env.UV_THREADPOOL_SIZE = 6;\npbkdf2('pwd', 'salt', 100000, 512, 'sha512', () => console.log('Done'));",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b3g"
    },
    {
      "id": "nd06x7zi216d",
      "type": "text",
      "x": 0,
      "y": 6199.25,
      "width": 1075.2,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
