    {
      "id": "shhx8d9yban9",
      "type": "text",
      "x": 1260,
      "y": 19774.25,
      "width": 463.68000000000006,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
