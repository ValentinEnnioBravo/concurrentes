    {
      "id": "e73j637bql75",
      "type": "text",
      "x": 40,
      "y": 7324.25,
      "width": 729.6,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 477799814,
      "version": 1,
      "versionNonce": 1240487631,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "cuentaA.puedeExtraer(50)\n  .then(puede => puede ? cuentaA.extraer(50) : Promise.reject('sin fondos'))\n  .then(() => cuentaB.depositar(50))\n  .catch(err => console.log(err));",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cuentaA.puedeExtraer(50)\n  .then(puede => puede ? cuentaA.extraer(50) : Promise.reject('sin fondos'))\n  .then(() => cuentaB.depositar(50))\n  .catch(err => console.log(err));",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b49"
    },
    {
      "id": "863dec9saw76",
