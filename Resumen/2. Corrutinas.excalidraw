      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "limite = asyncio.Semaphore(4)\n\nasync def consultar(linea):\n    async with limite:      # si ya hay 4 adentro, espera\n        return await pedir_linea(linea)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "limite = asyncio.Semaphore(4)\n\nasync def consultar(linea):\n    async with limite:      # si ya hay 4 adentro, espera\n        return await pedir_linea(linea)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAU"
    },
    {
      "id": "752aooeyroi3",
      "type": "text",
      "x": 671.4,
      "y": 15697.25,
      "width": 478.80000000000007,
      "height": 118.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
