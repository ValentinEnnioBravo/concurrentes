      "type": "text",
      "x": 0,
      "y": 1848,
      "width": 548.8000000000001,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
