    {
      "id": "qvulqgbv6lg9",
      "type": "text",
      "x": 20,
      "y": 14890.75,
      "width": 514.08,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
