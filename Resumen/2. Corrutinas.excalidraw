      "link": null,
      "locked": false,
      "text": "async def fetch(url):\n    reader, writer = await asyncio.open_connection(\n        'bla.com', 80)             # se pausa al conectar\n    writer.write(f'GET {url} ...'.encode())\n    respuesta = await reader.read()  # se pausa\n    parse_response(respuesta)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def fetch(url):\n    reader, writer = await asyncio.open_connection(\n        'bla.com', 80)             # se pausa al conectar\n    writer.write(f'GET {url} ...'.encode())\n    respuesta = await reader.read()  # se pausa\n    parse_response(respuesta)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b7A"
    },
