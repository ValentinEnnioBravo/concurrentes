      "roundness": null,
      "seed": 1688555916,
      "version": 1,
      "versionNonce": 1708018480,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Lanzar todo junto puede saturar al servicio.\nEl semáforo acota cuántas corrutinas están en\nla sección a la vez. Las extra esperan su\nturno: menos carga, a cambio de que el tiempo\ntotal pueda crecer.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lanzar todo junto puede saturar al servicio.\nEl semáforo acota cuántas corrutinas están en\nla sección a la vez. Las extra esperan su\nturno: menos carga, a cambio de que el tiempo\ntotal pueda crecer.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAV"
    },
    {
      "id": "6bodfrqjk4i4",
      "type": "text",
      "x": 20,
