    {
      "id": "xa6fkb20wv8h",
      "type": "text",
      "x": 1260,
      "y": 8921.5,
      "width": 473.76000000000005,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
