      "text": "selector = DefaultSelector()\n\nsock = socket.socket()\nsock.setblocking(False)          # vuelve enseguida\ntry:\n    sock.connect(('bla.com', 80)) # lanza BlockingIOError\nexcept BlockingIOError:\n    pass                         # \"empecé, no terminé\"\n\ndef connected():                 # el callback\n    selector.unregister(sock.fileno())\n    print('connected!')\n\n# \"avisame cuando se pueda escribir y llamá a connected\"\nselector.register(sock.fileno(), EVENT_WRITE, connected)\n\ndef loop():                      # el event loop\n    while True:\n        events = selector.select()   # duerme sin CPU\n        for event_key, event_mask in events:\n            callback = event_key.data\n            callback()",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "selector = DefaultSelector()\n\nsock = socket.socket()\nsock.setblocking(False)          # vuelve enseguida\ntry:\n    sock.connect(('bla.com', 80)) # lanza BlockingIOError\nexcept BlockingIOError:\n    pass                         # \"empecé, no terminé\"\n\ndef connected():                 # el callback\n    selector.unregister(sock.fileno())\n    print('connected!')\n\n# \"avisame cuando se pueda escribir y llamá a connected\"\nselector.register(sock.fileno(), EVENT_WRITE, connected)\n\ndef loop():                      # el event loop\n    while True:\n        events = selector.select()   # duerme sin CPU\n        for event_key, event_mask in events:\n            callback = event_key.data\n            callback()",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4K"
    },
