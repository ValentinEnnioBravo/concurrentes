      "locked": false,
      "text": "async def retirar(monto):        # MAL\n    if saldo >= monto:           # leo\n        await auditar()          # cede el control\n        saldo -= monto           # ¡dato viejo!",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def retirar(monto):        # MAL\n    if saldo >= monto:           # leo\n        await auditar()          # cede el control\n        saldo -= monto           # ¡dato viejo!",
