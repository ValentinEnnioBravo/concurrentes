    {
      "id": "as0fjnw5a98t",
      "type": "text",
      "x": 40,
      "y": 9436.5,
      "width": 346.8,
      "height": 191.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1572768620,
      "version": 1,
      "versionNonce": 1816811055,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "def cuenta_regresiva(numero):\n    while numero > 0:\n        yield numero\n        numero -= 1\n\nfor numero in cuenta_regresiva(5):\n    print(numero)\n\n# Imprime: 5 4 3 2 1",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def cuenta_regresiva(numero):\n    while numero > 0:\n        yield numero\n        numero -= 1\n\nfor numero in cuenta_regresiva(5):\n    print(numero)\n\n# Imprime: 5 4 3 2 1",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b57"
    },
    {
      "id": "6zzw7ra42c8u",
