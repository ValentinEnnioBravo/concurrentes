      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "En Python (como en MRI) hay GIL: aunque haya 50 threads, ejecuta bytecode uno solo. Lo sueltan al\nesperar I/O → sirven para solapar esperas, no para paralelismo de CPU.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En Python (como en MRI) hay GIL: aunque haya 50 threads, ejecuta bytecode uno solo. Lo sueltan al\nesperar I/O → sirven para solapar esperas, no para paralelismo de CPU.",
      "autoResize": true,
      "lineHeight": 1.25
    },
