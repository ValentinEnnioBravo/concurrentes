    {
      "id": "s83465hfsu6f",
      "type": "text",
      "x": 25,
      "y": 6289.25,
      "width": 1019.2,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
