      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Porque el socket es no bloqueante: la excepción\nsignifica \"empecé el handshake y todavía no\nterminé\" (EINPROGRESS). Se ignora con pass.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Porque el socket es no bloqueante: la excepción\nsignifica \"empecé el handshake y todavía no\nterminé\" (EINPROGRESS). Se ignora con pass.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4v"
    },
