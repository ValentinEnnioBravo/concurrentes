      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Cada thread pesa ~50 KB y el SO limita cuántos se\ncrean → te quedás sin memoria / threads ANTES que\nsin sockets: problema C10K (10.000 conexiones a la\nvez).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cada thread pesa ~50 KB y el SO limita cuántos se\ncrean → te quedás sin memoria / threads ANTES que\nsin sockets: problema C10K (10.000 conexiones a la\nvez).",
      "autoResize": true,
      "lineHeight": 1.25
    },
