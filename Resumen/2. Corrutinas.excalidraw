      "text": "En gather (sin return_exceptions), si una tarea falla, ¿se cancelan las otras?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En gather (sin return_exceptions), si una tarea falla, ¿se cancelan las otras?",
      "autoResize": true,
