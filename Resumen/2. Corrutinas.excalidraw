      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Los callbacks NO desaparecen: quedan ESCONDIDOS en Task y Future. En asyncio: función generadora →\nasync def · yield future → await · Task → asyncio.create_task · loop → asyncio.run.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los callbacks NO desaparecen: quedan ESCONDIDOS en Task y Future. En asyncio: función generadora →\nasync def · yield future → await · Task → asyncio.create_task · loop → asyncio.run.",
      "autoResize": true,
      "lineHeight": 1.25
    },
