      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "connect lanza BlockingIOError (EINPROGRESS) aunque\ntodo vaya bien: \"ya arranqué el handshake, seguí\". Se\nignora. Ahora no sabemos cuándo termina → no\ndeterminismo.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "connect lanza BlockingIOError (EINPROGRESS) aunque\ntodo vaya bien: \"ya arranqué el handshake, seguí\". Se\nignora. Ahora no sabemos cuándo termina → no\ndeterminismo.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4N"
    },
