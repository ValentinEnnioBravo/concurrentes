    },
    {
      "id": "069w15im2sl1",
      "type": "text",
      "x": 0,
      "y": 18108.75,
      "width": 1142.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1452773328,
      "version": 1,
      "versionNonce": 994593754,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Fibers (ej. Ruby): otra tarea suspendible. Se suspende y continúa donde quedó; el runtime ejecuta otra\nen el mismo thread durante la espera. Igual que con corrutinas, una llamada bloqueante dentro de la\nfiber ocupa el thread si el runtime no la delega.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fibers (ej. Ruby): otra tarea suspendible. Se suspende y continúa donde quedó; el runtime ejecuta otra\nen el mismo thread durante la espera. Igual que con corrutinas, una llamada bloqueante dentro de la\nfiber ocupa el thread si el runtime no la delega.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCD"
    },
    {
      "id": "eyq07dc2xtl2",
      "type": "text",
      "x": 20,
      "y": 18208.75,
      "width": 425.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1213661580,
      "version": 1,
      "versionNonce": 1015021699,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿El SO decide qué corrutina retomar?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿El SO decide qué corrutina retomar?",
