      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "succesorCont(1, y => succesorCont(y, x => console.log(x)));   // anida...\n\nfunction componer(f, g) {\n  return (x, cont) => g(x, (y) => f(y, cont));\n}\nconst pipeline = (fs) => fs.reduce(componer);\npipeline([duplicar, inversa, siguiente])(2, imprimir);",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "succesorCont(1, y => succesorCont(y, x => console.log(x)));   // anida...\n\nfunction componer(f, g) {\n  return (x, cont) => g(x, (y) => f(y, cont));\n}\nconst pipeline = (fs) => fs.reduce(componer);\npipeline([duplicar, inversa, siguiente])(2, imprimir);",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b27"
    },
