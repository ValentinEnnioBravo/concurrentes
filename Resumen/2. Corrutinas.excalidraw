      "seed": 241601871,
      "version": 1,
      "versionNonce": 862263343,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Por eso son ideales para I/O y no para CPU: no hay un planificador que desaloje a una corrutina que se\npasa de largo calculando.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Por eso son ideales para I/O y no para CPU: no hay un planificador que desaloje a una corrutina que se\npasa de largo calculando.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCA"
    },
