    {
      "id": "5a4zbgwmtkdj",
      "type": "text",
      "x": 620,
      "y": 13487.25,
      "width": 432,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
