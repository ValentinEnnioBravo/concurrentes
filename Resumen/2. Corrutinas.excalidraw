      "roundness": null,
      "seed": 941394753,
      "version": 1,
      "versionNonce": 1490874835,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "En CPS la continuación se PASA como argumento;\ncon Promises la función DEVUELVE la promesa y\nla continuación se engancha después con .then,\nencadenando en vez de anidar.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En CPS la continuación se PASA como argumento;\ncon Promises la función DEVUELVE la promesa y\nla continuación se engancha después con .then,\nencadenando en vez de anidar.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4C"
    },
