    {
      "id": "g12jysjc16",
      "type": "text",
      "x": 0,
      "y": 3048,
      "width": 1086.4,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
