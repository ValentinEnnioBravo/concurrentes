      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "No. El SO planifica el THREAD del event loop y\navisa que la I/O está lista; el event loop\nelige qué corrutina reanudar.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No. El SO planifica el THREAD del event loop y\navisa que la I/O está lista; el event loop\nelige qué corrutina reanudar.",
