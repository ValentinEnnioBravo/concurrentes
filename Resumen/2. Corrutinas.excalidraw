    },
    {
      "id": "a8hqcblnjnik",
      "type": "text",
      "x": 0,
      "y": 16344.75,
      "width": 1153.6000000000001,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
