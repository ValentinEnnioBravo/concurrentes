      "versionNonce": 1081538585,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "\"Estas tareas son una unidad de trabajo; si una\nfalla, cancelá las demás.\"\nCancelar NO es deshacer: lo que las hermanas ya\nhicieron queda hecho. No es una transacción con\nrollback.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Estas tareas son una unidad de trabajo; si una\nfalla, cancelá las demás.\"\nCancelar NO es deshacer: lo que las hermanas ya\nhicieron queda hecho. No es una transacción con\nrollback.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b9U"
    },
