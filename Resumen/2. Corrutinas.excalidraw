    },
    {
      "id": "pjcx2bmzsx8e",
      "type": "text",
      "x": 25,
      "y": 8791.5,
      "width": 1108.8000000000002,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1749592441,
      "version": 1,
      "versionNonce": 1891365508,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "El problema: la lógica de fetch (conectar → enviar → leer → parsear) queda PARTIDA en callbacks, y\nel estado (qué socket, qué llevo leído) vive AFUERA, en globales u objetos. Mismo problema que CPS.\n→ Queremos escribir código secuencial que se pueda PAUSAR en cada espera: funciones pausables.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "El problema: la lógica de fetch (conectar → enviar → leer → parsear) queda PARTIDA en callbacks, y\nel estado (qué socket, qué llevo leído) vive AFUERA, en globales u objetos. Mismo problema que CPS.\n→ Queremos escribir código secuencial que se pueda PAUSAR en cada espera: funciones pausables.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4s"
    },
    {
      "id": "56dm1tsrea8f",
      "type": "text",
      "x": 20,
      "y": 8911.5,
      "width": 716.8000000000001,
      "height": 25,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
