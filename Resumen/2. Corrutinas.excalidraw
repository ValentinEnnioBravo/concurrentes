      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Correr el trabajo pesado en\notros threads sin bloquear el\nloop.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b3e"
    },
    {
