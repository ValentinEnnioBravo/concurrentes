      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "No: la excepción le llega a quien hizo await,\npero las otras siguen corriendo. TaskGroup sí\nlas cancela (y cancelar no es deshacer).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No: la excepción le llega a quien hizo await,\npero las otras siguen corriendo. TaskGroup sí\nlas cancela (y cancelar no es deshacer).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAc"
    },
