      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "let a = 0;\nfor (let i = 0; i < 10000; i++) {\n  setTimeout(() => a += 1, 0);     // encola un evento\n}\nsetTimeout(() => console.log('Dentro:', a), 3300);\nconsole.log('Fuera:', a);",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let a = 0;\nfor (let i = 0; i < 10000; i++) {\n  setTimeout(() => a += 1, 0);     // encola un evento\n}\nsetTimeout(() => console.log('Dentro:', a), 3300);\nconsole.log('Fuera:', a);",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b35"
    },
