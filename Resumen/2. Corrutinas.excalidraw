      "text": "async def bloqueante():\n    time.sleep(2)           # congela el loop 2 s\n\nasync def cooperativa():\n    await asyncio.sleep(2)  # cede: el loop atiende otras\n\nawait asyncio.gather(bloqueante(), bloqueante())\nawait asyncio.gather(cooperativa(), cooperativa())",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def bloqueante():\n    time.sleep(2)           # congela el loop 2 s\n\nasync def cooperativa():\n    await asyncio.sleep(2)  # cede: el loop atiende otras\n\nawait asyncio.gather(bloqueante(), bloqueante())\nawait asyncio.gather(cooperativa(), cooperativa())",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAo"
    },
