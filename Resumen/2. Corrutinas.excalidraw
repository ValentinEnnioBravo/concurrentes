    {
      "id": "q2xuw8hdo0ey",
      "type": "text",
      "x": 530,
      "y": 13877.25,
      "width": 342.72,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
