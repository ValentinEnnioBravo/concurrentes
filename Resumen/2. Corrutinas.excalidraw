      "link": null,
      "locked": false,
      "text": "Ninguno de los dos da paralelismo de CPU\n(corrutinas: 1 thread; threads: GIL). Hace\nfalta un pool de procesos\n(ProcessPoolExecutor).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ninguno de los dos da paralelismo de CPU\n(corrutinas: 1 thread; threads: GIL). Hace\nfalta un pool de procesos\n(ProcessPoolExecutor).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bDl"
