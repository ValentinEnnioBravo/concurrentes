      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "await a() y después await b() (1 s y 2 s) vs. gather(a(), b()): ¿cuánto tarda cada uno?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "await a() y después await b() (1 s y 2 s) vs. gather(a(), b()): ¿cuánto tarda cada uno?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bAW"
    },
