      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿Por qué connect lanza BlockingIOError si la conexión va bien?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué connect lanza BlockingIOError si la conexión va bien?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4t"
    },
    {
      "id": "wju1c721o38g",
