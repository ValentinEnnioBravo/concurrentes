      "index": "bC9"
    },
    {
      "id": "c1ielgamgaky",
      "type": "text",
      "x": 0,
      "y": 18033.75,
      "width": 1142.4,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
