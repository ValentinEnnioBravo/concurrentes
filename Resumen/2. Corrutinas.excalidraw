      "locked": false,
      "text": "¿Qué cambia entre CPS y Promises respecto de la continuación?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Qué cambia entre CPS y Promises respecto de la continuación?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4A"
    },
    {
