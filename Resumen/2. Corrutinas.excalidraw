      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "def io():\n    time.sleep(1); print(1)\n    time.sleep(1); print(2)\n    time.sleep(1); print(3)\n\ndef main(tareas):\n    for tarea in tareas:\n        io()\n\nmain(range(3))\n# 1 2 3 1 2 3 1 2 3  →  9.01 s",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def io():\n    time.sleep(1); print(1)\n    time.sleep(1); print(2)\n    time.sleep(1); print(3)\n\ndef main(tareas):\n    for tarea in tareas:\n        io()\n\nmain(range(3))\n# 1 2 3 1 2 3 1 2 3  →  9.01 s",
      "autoResize": true,
