      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "select() es epoll_wait() en Linux: el thread se\nbloquea SIN gastar CPU hasta que el kernel marca un\ndescriptor listo. Ejecuta el callback de cada evento.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "select() es epoll_wait() en Linux: el thread se\nbloquea SIN gastar CPU hasta que el kernel marca un\ndescriptor listo. Ejecuta el callback de cada evento.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b4T"
    },
