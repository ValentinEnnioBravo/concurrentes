    },
    {
      "id": "2ljla40u7n78",
      "type": "text",
      "x": 1260,
      "y": 7459.25,
      "width": 463.68000000000006,
      "height": 90,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
