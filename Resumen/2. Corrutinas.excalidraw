      "seed": 1060018192,
      "version": 1,
      "versionNonce": 765393248,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Igual que los generadores, llamar a un async def NO ejecuta su cuerpo: devuelve un objeto corrutina\ncongelado. Alguien tiene que planificarlo:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Igual que los generadores, llamar a un async def NO ejecuta su cuerpo: devuelve un objeto corrutina\ncongelado. Alguien tiene que planificarlo:",
