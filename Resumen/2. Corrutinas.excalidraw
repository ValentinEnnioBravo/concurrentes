    },
    {
      "id": "9rnfc2tbtjf4",
      "type": "text",
      "x": 0,
      "y": 14272.25,
      "width": 1108.8000000000002,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
