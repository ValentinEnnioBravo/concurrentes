    {
      "id": "pvz5kh8yfxgc",
      "type": "text",
      "x": 612.5,
      "y": 14890.75,
      "width": 493.9200000000001,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
