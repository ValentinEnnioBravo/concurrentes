    },
    {
      "id": "j2nrixkfwxf1",
      "type": "text",
      "x": 25,
      "y": 14152.25,
      "width": 1086.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1185349356,
      "version": 1,
      "versionNonce": 1290976659,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Simultánea de ajedrez: una persona juega contra varias, mueve en un tablero y pasa al siguiente\nsin esperar la respuesta. Hay CONCURRENCIA, no paralelismo. Si en vez de sleep fuera un cálculo\npesado, no ganaríamos nada.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Simultánea de ajedrez: una persona juega contra varias, mueve en un tablero y pasa al siguiente\nsin esperar la respuesta. Hay CONCURRENCIA, no paralelismo. Si en vez de sleep fuera un cálculo\npesado, no ganaríamos nada.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8j"
    },
