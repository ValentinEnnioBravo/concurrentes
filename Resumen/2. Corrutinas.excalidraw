    {
      "id": "yiwmw8qdl427",
      "type": "text",
      "x": 25,
      "y": 1297.5,
      "width": 1041.6000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 394378092,
      "version": 1,
      "versionNonce": 2027146283,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "GIL: en Python (igual que MRI) aunque haya 50 threads, solo uno ejecuta bytecode a la vez. Lo\nsueltan mientras esperan I/O → sirven para solapar esperas, no dan paralelismo de CPU.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GIL: en Python (igual que MRI) aunque haya 50 threads, solo uno ejecuta bytecode a la vez. Lo\nsueltan mientras esperan I/O → sirven para solapar esperas, no dan paralelismo de CPU.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1H"
    },
    {
      "id": "8naj7be3ck28",
      "type": "text",
      "x": 20,
      "y": 1392.5,
      "width": 649.6,
      "height": 25,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1355423853,
      "version": 1,
      "versionNonce": 1152811029,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿Por qué C10K es un problema de threads y no de sockets?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué C10K es un problema de threads y no de sockets?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1I"
    },
    {
      "id": "oumy1ag92e29",
      "type": "rectangle",
      "x": 1240,
      "y": 1387.5,
      "width": 520,
      "height": 120,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 42029628,
      "version": 1,
      "versionNonce": 1020782284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "index": "b1J"
    },
    {
      "id": "jyr9teph1x2a",
      "type": "text",
      "x": 1260,
      "y": 1402.5,
      "width": 473.76000000000005,
      "height": 90,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 975442048,
      "version": 1,
      "versionNonce": 1503694666,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Un socket es barato. Cada thread pesa ~50 KB y\nel SO limita cuántos se crean: te quedás sin\nmemoria/threads antes que sin sockets. Ideal: 1\nthread para muchos sockets.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un socket es barato. Cada thread pesa ~50 KB y\nel SO limita cuántos se crean: te quedás sin\nmemoria/threads antes que sin sockets. Ideal: 1\nthread para muchos sockets.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1K"
    },
