    {
      "id": "g11jz0fi25",
      "type": "text",
      "x": 0,
      "y": 2820.5,
      "width": 1142.4,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
