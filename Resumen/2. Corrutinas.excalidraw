      "versionNonce": 1389,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Piezas: HEAP (variables y estructuras) · CALL STACK (funciones en ejecución, una cosa a la vez) ·\nCALLBACK QUEUE. Fases del loop: Timers → JS → I/O → setImmediate → Close events.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Piezas: HEAP (variables y estructuras) · CALL STACK (funciones en ejecución, una cosa a la vez) ·\nCALLBACK QUEUE. Fases del loop: Timers → JS → I/O → setImmediate → Close events.",
      "autoResize": true,
      "lineHeight": 1.25
    },
