    },
    {
      "id": "g1hpfei02n",
      "type": "text",
      "x": 0,
      "y": 7394.25,
      "width": 1131.2,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1934,
      "version": 2,
      "versionNonce": 1135156268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "OTP es un conjunto de middlewares, librerías y herramientas escritas en Erlang que encapsulan todo lo\nanterior para no reinventar la rueda. GENSERVER es la parte de OTP para crear procesos de VIDA LARGA:\nen vez de ejecutar una función y morir (como con spawn), el proceso queda ESCUCHANDO SU MAILBOX en un\nloop. GenServer resuelve ese loop y da una convención de callbacks (init, handle_call, handle_cast,\nhandle_info, terminate).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OTP es un conjunto de middlewares, librerías y herramientas escritas en Erlang que encapsulan todo lo\nanterior para no reinventar la rueda. GENSERVER es la parte de OTP para crear procesos de VIDA LARGA:\nen vez de ejecutar una función y morir (como con spawn), el proceso queda ESCUCHANDO SU MAILBOX en un\nloop. GenServer resuelve ese loop y da una convención de callbacks (init, handle_call, handle_cast,\nhandle_info, terminate).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yut"
    },
