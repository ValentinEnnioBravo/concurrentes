      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "¿Un receive sin mensajes consume CPU?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Un receive sin mensajes consume CPU?",
