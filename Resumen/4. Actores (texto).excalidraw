      "text": "{:ok, pid} = Agent.start_link(fn -> %{} end)\nAgent.update(pid, &Map.put(&1, :hello, 1))    # :ok\nAgent.get(pid, &Map.get(&1, :hello))          # 1",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{:ok, pid} = Agent.start_link(fn -> %{} end)\nAgent.update(pid, &Map.put(&1, :hello, 1))    # :ok\nAgent.get(pid, &Map.get(&1, :hello))          # 1",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yw9"
    },
