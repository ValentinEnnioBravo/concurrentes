    },
    {
      "id": "gugzv40qf",
      "type": "text",
      "x": 0,
      "y": 773,
      "width": 1108.8000000000002,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1097,
      "version": 2,
      "versionNonce": 1719732884,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "En Elixir, = no es solo asignación: es \"HACÉ COINCIDIR\" la forma de la izquierda con el valor de la\nderecha. Una función puede tener VARIAS CLÁUSULAS con distintos patrones: Elixir prueba EN ORDEN y\nejecuta la primera que coincide.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En Elixir, = no es solo asignación: es \"HACÉ COINCIDIR\" la forma de la izquierda con el valor de la\nderecha. Una función puede tener VARIAS CLÁUSULAS con distintos patrones: Elixir prueba EN ORDEN y\nejecuta la primera que coincide.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "YqO"
    },
    {
      "id": "gujwh8jin",
      "type": "rectangle",
      "x": 0,
      "y": 863,
      "width": 1160,
      "height": 150,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
