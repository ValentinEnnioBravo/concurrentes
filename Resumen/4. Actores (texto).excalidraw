      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "Para conocer el estado de otro actor hay que pedírselo por mensaje. Cada actor controla\nel acceso a su estado (encapsulamiento) → evita condiciones de carrera.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para conocer el estado de otro actor hay que pedírselo por mensaje. Cada actor controla\nel acceso a su estado (encapsulamiento) → evita condiciones de carrera.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yqi"
    },
