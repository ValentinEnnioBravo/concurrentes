    {
      "id": "g29dsn968j",
      "type": "text",
      "x": 660,
      "y": 15779.25,
      "width": 403.2,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
