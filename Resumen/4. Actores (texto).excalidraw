    },
    {
      "id": "g2aprkei70",
      "type": "text",
      "x": 20,
      "y": 16924.25,
      "width": 1027.2,
      "height": 320,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2978,
      "version": 2,
      "versionNonce": 1094168364,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "# Application: Registry \"pelado\" + supervisor dinámico (registry a nivel app)\nchildren = [{Registry, keys: :unique, name: AccountMainRegistry}, AccountDynamicSupervisor]\nSupervisor.start_link(children, strategy: :one_for_one, name: RegistrySupervisor)\n\n# Account (GenServer): el id del child spec y la clave del Registry son el account_id (único)\ndef child_spec(id), do: %{id: \"account_#{id}\", start: {__MODULE__, :start_link, [id]}, restart: :transient}\ndef start_link(id) when is_integer(id),                        # \"when\" es una GUARDA\n  do: GenServer.start_link(__MODULE__, id, name: via_tuple(id))\ndefp via_tuple(id), do: {:via, Registry, {@registry, id, \"Cuenta #{id}\"}}   # {registro, clave, valor}\n\ndef where_is(id) do\n  case Registry.lookup(@registry, id) do       # [{pid, valor}] si existe, [] si no\n    [{pid, _desc}] -> pid\n    [] -> nil\n  end\nend",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Application: Registry \"pelado\" + supervisor dinámico (registry a nivel app)\nchildren = [{Registry, keys: :unique, name: AccountMainRegistry}, AccountDynamicSupervisor]\nSupervisor.start_link(children, strategy: :one_for_one, name: RegistrySupervisor)\n\n# Account (GenServer): el id del child spec y la clave del Registry son el account_id (único)\ndef child_spec(id), do: %{id: \"account_#{id}\", start: {__MODULE__, :start_link, [id]}, restart: :transient}\ndef start_link(id) when is_integer(id),                        # \"when\" es una GUARDA\n  do: GenServer.start_link(__MODULE__, id, name: via_tuple(id))\ndefp via_tuple(id), do: {:via, Registry, {@registry, id, \"Cuenta #{id}\"}}   # {registro, clave, valor}\n\ndef where_is(id) do\n  case Registry.lookup(@registry, id) do       # [{pid, valor}] si existe, [] si no\n    [{pid, _desc}] -> pid\n    [] -> nil\n  end\nend",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ZV"
    },
    {
      "id": "g2ascw8omp",
      "type": "text",
      "x": 0,
      "y": 17279.25,
      "width": 1153.6000000000001,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2981,
      "version": 2,
      "versionNonce": 1388259732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "• name: {:via, Registry, {registro, clave, valor}}: en vez de un nombre fijo, \"registrate A TRAVÉS de\n  este Registry con esta clave\" (:via es la convención). El VALOR es un dato extra opcional (\"Cuenta\n  1\"); el PID NO lo pasamos nosotros, lo pone el Registry.\n• Como la clave del Registry es el id de la cuenta, ya no hace falta un átomo por proceso, y el id del\n  child spec usa el mismo valor único. Truco para el TP: si tenés un valor único, usalo para armar el\n  id.\n• Con las primitivas se arman abstracciones: listar cuentas (Registry.select con un match spec heredado\n  de Erlang → [2, 3, 5]), exists?, find_or_create (si where_is da nil, DynamicSupervisor.start_child).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• name: {:via, Registry, {registro, clave, valor}}: en vez de un nombre fijo, \"registrate A TRAVÉS de\n  este Registry con esta clave\" (:via es la convención). El VALOR es un dato extra opcional (\"Cuenta\n  1\"); el PID NO lo pasamos nosotros, lo pone el Registry.\n• Como la clave del Registry es el id de la cuenta, ya no hace falta un átomo por proceso, y el id del\n  child spec usa el mismo valor único. Truco para el TP: si tenés un valor único, usalo para armar el\n  id.\n• Con las primitivas se arman abstracciones: listar cuentas (Registry.select con un match spec heredado\n  de Erlang → [2, 3, 5]), exists?, find_or_create (si where_is da nil, DynamicSupervisor.start_child).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ZW"
    },
