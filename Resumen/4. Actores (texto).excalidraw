      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "{pid, ref} = spawn_monitor(fn -> receive do :crash -> raise \"boom\" end end)   # crear y monitorear\nref = Process.monitor(pid)                                                     # monitorear uno que ya existe\nProcess.info(self(), :monitors)                    # {:monitors, [process: #PID<0.118.0>]}\n\n{:DOWN, ref, :process, pid, razon}    # lo que llega: siempre :DOWN, la ref, el tipo, el PID que murió y por qué",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{pid, ref} = spawn_monitor(fn -> receive do :crash -> raise \"boom\" end end)   # crear y monitorear\nref = Process.monitor(pid)                                                     # monitorear uno que ya existe\nProcess.info(self(), :monitors)                    # {:monitors, [process: #PID<0.118.0>]}\n\n{:DOWN, ref, :process, pid, razon}    # lo que llega: siempre :DOWN, la ref, el tipo, el PID que murió y por qué",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yu1"
