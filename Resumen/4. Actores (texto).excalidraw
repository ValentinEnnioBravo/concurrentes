    },
    {
      "id": "gwy1esvs4",
      "type": "text",
      "x": 25,
      "y": 1706.75,
      "width": 1075.2,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1187,
      "version": 2,
      "versionNonce": 286074132,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "Actores vs. objetos: en el modelo de objetos muchos objetos corren en una misma unidad de\nprocesamiento y COMPARTEN RECURSOS (memoria). Los actores son en sí mismos un CONTEXTO DE\nEJECUCIÓN, completamente aislados. No tienen métodos: en Elixir hay MÓDULOS (parecidos a clases)\ncon funciones que se le pasan al actor para que ejecute.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Actores vs. objetos: en el modelo de objetos muchos objetos corren en una misma unidad de\nprocesamiento y COMPARTEN RECURSOS (memoria). Los actores son en sí mismos un CONTEXTO DE\nEJECUCIÓN, completamente aislados. No tienen métodos: en Elixir hay MÓDULOS (parecidos a clases)\ncon funciones que se le pasan al actor para que ejecute.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yqs"
    },
