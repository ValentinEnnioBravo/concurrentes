      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "* que no atrapa salidas (sin trap_exit)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* que no atrapa salidas (sin trap_exit)",
