      "link": null,
      "locked": false,
      "text": "No: el proceso se suspende y el scheduler no\nle asigna CPU hasta que llega un mensaje.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No: el proceso se suspende y el scheduler no\nle asigna CPU hasta que llega un mensaje.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Ysz"
    },
