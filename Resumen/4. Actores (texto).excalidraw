    {
      "id": "gws13kpy6",
      "type": "text",
      "x": 300,
      "y": 1609.25,
      "width": 733.0400000000001,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
