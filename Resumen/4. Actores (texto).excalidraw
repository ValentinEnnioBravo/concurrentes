    },
    {
      "id": "g1mgpn29hn",
      "type": "text",
      "x": 20,
      "y": 8734.25,
      "width": 1017.5999999999999,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2105,
      "version": 2,
      "versionNonce": 1145939604,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "defmodule Crashy do      # GenServer hecho para fallar a propósito\n  def start(state),             do: GenServer.start(__MODULE__, state, name: __MODULE__)        # sin link\n  def start_link(state, name),  do: GenServer.start_link(__MODULE__, state, name: name)        # con link\n  def handle_cast(:crash, state), do: (_ = 1 / 0; {:noreply, state})       # explota\n  def handle_info({:blah, pid}, state), do: (Logger.info(\"mensaje de #{inspect(pid)}\"); {:noreply, state})\n  def terminate(reason, _state), do: Logger.info(\"#{inspect(reason)} in terminate\")\nend",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "defmodule Crashy do      # GenServer hecho para fallar a propósito\n  def start(state),             do: GenServer.start(__MODULE__, state, name: __MODULE__)        # sin link\n  def start_link(state, name),  do: GenServer.start_link(__MODULE__, state, name: name)        # con link\n  def handle_cast(:crash, state), do: (_ = 1 / 0; {:noreply, state})       # explota\n  def handle_info({:blah, pid}, state), do: (Logger.info(\"mensaje de #{inspect(pid)}\"); {:noreply, state})\n  def terminate(reason, _state), do: Logger.info(\"#{inspect(reason)} in terminate\")\nend",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yvo"
    },
    {
      "id": "g1mjzlpeks",
      "type": "text",
      "x": 0,
      "y": 8904.25,
      "width": 1008.0000000000001,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
