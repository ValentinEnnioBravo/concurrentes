    {
      "id": "g24drp8vmu",
      "type": "text",
      "x": 18,
      "y": 14325,
      "width": 528.6400000000001,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
