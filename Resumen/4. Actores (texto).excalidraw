    },
    {
      "id": "g297hx1wpa",
      "type": "text",
      "x": 0,
      "y": 15764.25,
      "width": 594.72,
      "height": 292.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2924,
      "version": 2,
      "versionNonce": 734367916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "Si un supervisor se cae, se caen todos sus hijos. ¿Quién\nsupervisa a los supervisores? OTRO SUPERVISOR → un ÁRBOL:\nlas RAMAS son supervisores (type: :supervisor) y las HOJAS,\nworkers.\n• RAÍZ: se inicia con la aplicación (start de Application).\n  Suele ser estático.\n• INTERMEDIOS: agrupan procesos relacionados para AISLAR\n  FALLAS, cada uno con su estrategia (:one_for_all\n  interdependientes, :one_for_one independientes).\n• ESCALAMIENTO: si un supervisor supera su intensidad,\n  muere y su padre lo reinicia con todo su subárbol; sube\n  nivel por nivel y SI LA RAÍZ MUERE, TERMINA LA\n  APLICACIÓN.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si un supervisor se cae, se caen todos sus hijos. ¿Quién\nsupervisa a los supervisores? OTRO SUPERVISOR → un ÁRBOL:\nlas RAMAS son supervisores (type: :supervisor) y las HOJAS,\nworkers.\n• RAÍZ: se inicia con la aplicación (start de Application).\n  Suele ser estático.\n• INTERMEDIOS: agrupan procesos relacionados para AISLAR\n  FALLAS, cada uno con su estrategia (:one_for_all\n  interdependientes, :one_for_one independientes).\n• ESCALAMIENTO: si un supervisor supera su intensidad,\n  muere y su padre lo reinicia con todo su subárbol; sube\n  nivel por nivel y SI LA RAÍZ MUERE, TERMINA LA\n  APLICACIÓN.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ZD"
    },
