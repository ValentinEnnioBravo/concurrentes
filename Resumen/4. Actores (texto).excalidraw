      "versionNonce": 923634452,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795624547108,
      "link": null,
      "locked": false,
      "text": "Proceso especial de OTP cuyo único trabajo es SUPERVISAR A SUS HIJOS: los CREA al arrancar y los VUELVE\nA CREAR cuando fallan. Se encarga de TODO EL CICLO DE VIDA de sus hijos.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Proceso especial de OTP cuyo único trabajo es SUPERVISAR A SUS HIJOS: los CREA al arrancar y los VUELVE\nA CREAR cuando fallan. Se encarga de TODO EL CICLO DE VIDA de sus hijos.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "YxI"
    },
