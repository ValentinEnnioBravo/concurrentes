      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "OTP",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "g1hj4dbcqn",
      "originalText": "OTP",
      "autoResize": true,
      "lineHeight": 1.25,
