      "roundness": null,
      "seed": 1181,
      "version": 2,
      "versionNonce": 997275540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "Cada actor se ejecuta concurrentemente con los demás, como un pequeño proceso\nindependiente.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cada actor se ejecuta concurrentemente con los demás, como un pequeño proceso\nindependiente.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Yqq"
    },
    {
      "id": "gwvkj1sif",
