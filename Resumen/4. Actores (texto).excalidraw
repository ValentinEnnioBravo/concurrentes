      "text": "receive do\n  {:hello, msg} -> msg\n  _otro -> :descartado\nafter\n  1_000 -> \"no llegó nada en 1 segundo\"\nend",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "receive do\n  {:hello, msg} -> msg\n  _otro -> :descartado\nafter\n  1_000 -> \"no llegó nada en 1 segundo\"\nend",
      "autoResize": true,
