    },
    {
      "id": "g25v8zssgt",
      "type": "text",
      "x": 20,
      "y": 15178,
      "width": 931.1999999999999,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2804,
      "version": 2,
      "versionNonce": 762125996,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "def child_spec({name, state, restart_type}) do\n  %{id: name, start: {__MODULE__, :start_link, [state, name]},   # 2 args → start_link/2\n    type: :worker, restart: restart_type}\nend\ndef init(stack) do\n  Process.flag(:trap_exit, true)    # para que terminate se ejecute cuando el supervisor lo apaga\n  {:ok, stack}\nend",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def child_spec({name, state, restart_type}) do\n  %{id: name, start: {__MODULE__, :start_link, [state, name]},   # 2 args → start_link/2\n    type: :worker, restart: restart_type}\nend\ndef init(stack) do\n  Process.flag(:trap_exit, true)    # para que terminate se ejecute cuando el supervisor lo apaga\n  {:ok, stack}\nend",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "YzZ"
    },
