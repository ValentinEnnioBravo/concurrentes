      "lineHeight": 1.25,
      "index": "ZP"
    },
    {
      "id": "g2aa8uaycj",
      "type": "text",
      "x": 0,
      "y": 16569.25,
      "width": 1153.6000000000001,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2963,
      "version": 2,
      "versionNonce": 1758462228,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "Para encontrar un proceso teníamos dos opciones: guardar su PID (pero CUANDO EL SUPERVISOR LO REINICIA,\nEL PID CAMBIA y el viejo apunta a un proceso muerto) o registrarlo con un NOMBRE FIJO (name: Stack1),\npero son átomos escritos en el código y no queremos uno por cada cuenta o usuario.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Para encontrar un proceso teníamos dos opciones: guardar su PID (pero CUANDO EL SUPERVISOR LO REINICIA,\nEL PID CAMBIA y el viejo apunta a un proceso muerto) o registrarlo con un NOMBRE FIJO (name: Stack1),\npero son átomos escritos en el código y no queremos uno por cada cuenta o usuario.",
      "autoResize": true,
