    },
    {
      "id": "g1csyi0h44",
      "type": "text",
      "x": 25,
      "y": 5964.25,
      "width": 1064,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1757,
      "version": 2,
      "versionNonce": 488327060,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795622890105,
      "link": null,
      "locked": false,
      "text": "Bug del repo: Crashy tiene handle_info({\"EXIT\", pid, reason}, state) con \"EXIT\" como STRING. El\nmensaje real usa el ÁTOMO :EXIT, así que nunca coincide y explota con FunctionClauseError. Lo\ncorrecto: {:EXIT, pid, reason}.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bug del repo: Crashy tiene handle_info({\"EXIT\", pid, reason}, state) con \"EXIT\" como STRING. El\nmensaje real usa el ÁTOMO :EXIT, así que nunca coincide y explota con FunctionClauseError. Lo\ncorrecto: {:EXIT, pid, reason}.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "Ytw"
    },
