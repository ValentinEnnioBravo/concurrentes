      "text": "n = 5 réplicas sin líder. ¿Qué w y r garantizan\nleer el último valor?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n = 5 réplicas sin líder. ¿Qué w y r garantizan\nleer el último valor?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bDM"
    },
