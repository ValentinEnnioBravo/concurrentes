    },
    {
      "id": "d114hx3oom",
      "type": "text",
      "x": 0,
      "y": 9546,
      "width": 554.4000000000001,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1337,
      "version": 2,
      "versionNonce": 102418920,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "• Cae un SEGUIDOR → catch-up: sabe su última entrada\n  del log y al volver pide todo lo posterior. Fácil.\n• Cae el LÍDER → FAILOVER: 1) DETECTAR (timeout) · 2)\n  ELEGIR nuevo líder, el más actualizado (es un\n  problema de CONSENSO) · 3) RECONFIGURAR: los clientes\n  escriben al nuevo y el viejo, si vuelve, acepta que\n  ya no es líder.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Cae un SEGUIDOR → catch-up: sabe su última entrada\n  del log y al volver pide todo lo posterior. Fácil.\n• Cae el LÍDER → FAILOVER: 1) DETECTAR (timeout) · 2)\n  ELEGIR nuevo líder, el más actualizado (es un\n  problema de CONSENSO) · 3) RECONFIGURAR: los clientes\n  escriben al nuevo y el viejo, si vuelve, acepta que\n  ya no es líder.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCn"
    },
    {
      "id": "d1177t0c3r",
      "type": "rectangle",
      "x": 0,
      "y": 9721.5,
      "width": 560,
      "height": 138.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1340,
