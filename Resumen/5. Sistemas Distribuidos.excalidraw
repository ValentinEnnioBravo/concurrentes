      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Agregar un seguidor (no alcanza con copiar archivos:\nsiguen llegando escrituras):",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
