      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "n=3, w=2, r=2 → 4 > 3 ✅\nR1: x=7  R2: x=7  R3: x=5 → leo R2 y R3 → me quedo con 7",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
