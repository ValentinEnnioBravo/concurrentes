      "boundElements": [],
      "updated": 1795553625587,
      "link": null,
      "locked": false,
      "text": "CP: bloquea las compras (al menos del lado\nsin mayoría) → pierde ventas. AP: vende en\nambos → puede vender dos veces la última\nPlay 5 y tener que compensar.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CP: bloquea las compras (al menos del lado\nsin mayoría) → pierde ventas. AP: vende en\nambos → puede vender dos veces la última\nPlay 5 y tener que compensar.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bI1"
    },
