      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Ponerse de acuerdo entre nodos → origen de\nCONSENSO. Fusionar sin conflictos por diseño →\nCRDTs (apunte aparte).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ponerse de acuerdo entre nodos → origen de\nCONSENSO. Fusionar sin conflictos por diseño →\nCRDTs (apunte aparte).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bDL"
    },
