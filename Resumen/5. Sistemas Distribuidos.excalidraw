      "link": null,
      "locked": false,
      "text": "Si w + r > n → los conjuntos se SUPERPONEN:\nal menos una réplica leída tiene el último valor.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si w + r > n → los conjuntos se SUPERPONEN:\nal menos una réplica leída tiene el último valor.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bBg"
    },
    {
      "id": "dvgmplspg",
      "type": "text",
      "x": 15,
      "y": 8014,
      "width": 470.4,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
