      "versionNonce": 356329624,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "index": "bCo"
    },
    {
      "id": "d11apbin6t",
      "type": "text",
      "x": 18,
      "y": 9734.5,
      "width": 514.08,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1343,
      "version": 2,
      "versionNonce": 1190743272,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Qué sale mal: con async el nuevo líder puede NO\nTENER las últimas escrituras (se descartan) · SPLIT\nBRAIN: el viejo no murió, quedó aislado → DOS\nlíderes aceptando escrituras · timeout corto =\nfailovers innecesarios; largo = recuperación lenta.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Qué sale mal: con async el nuevo líder puede NO\nTENER las últimas escrituras (se descartan) · SPLIT\nBRAIN: el viejo no murió, quedó aislado → DOS\nlíderes aceptando escrituras · timeout corto =\nfailovers innecesarios; largo = recuperación lenta.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCp"
    },
