      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Trampa: \"tiene hilos del SO → hay paralelismo\". Con GIL es FALSO.\nTrampa: \"monohilo → no hay race conditions\". FALSO: el estado puede cambiar entre un\nawait / callback y el siguiente.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trampa: \"tiene hilos del SO → hay paralelismo\". Con GIL es FALSO.\nTrampa: \"monohilo → no hay race conditions\". FALSO: el estado puede cambiar entre un\nawait / callback y el siguiente.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b94"
    },
    {
      "id": "d27vsm7710",
      "type": "text",
      "x": 20,
      "y": 3281,
      "width": 683.2,
