      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Antes de sumar instancias, MEDÍ (throughput, latencia, saturación): si todas las copias\ndependen de la misma base saturada, agregar copias AUMENTA la presión sobre esa base.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Antes de sumar instancias, MEDÍ (throughput, latencia, saturación): si todas las copias\ndependen de la misma base saturada, agregar copias AUMENTA la presión sobre esa base.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bA7"
    },
