    },
    {
      "id": "d2eamvbv1d",
      "type": "text",
      "x": 0,
      "y": 5173.5,
      "width": 1142.4,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3107,
      "version": 2,
      "versionNonce": 1486667672,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Clonar NO es la única forma de escalar. El cubo (The Art of Scalability) tiene 3 ejes: el ORIGEN es el\nmonolito en un servidor y la esquina opuesta, la escalabilidad máxima. Los ejes SE COMBINAN.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
