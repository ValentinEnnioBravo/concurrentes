      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "¿Por qué JRuby usa 1 proceso para 4 núcleos y MRI necesita 4?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué JRuby usa 1 proceso para 4 núcleos y MRI necesita 4?",
