      "boundElements": [],
      "updated": 1795553583190,
      "link": null,
      "locked": false,
      "text": "Consistencia: la queremos lo más fuerte que podamos garantizar. Cuando no hace falta en tiempo real,\nse resuelve después con procesos de CONCILIACIÓN.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consistencia: la queremos lo más fuerte que podamos garantizar. Cuando no hace falta en tiempo real,\nse resuelve después con procesos de CONCILIACIÓN.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b03"
    },
