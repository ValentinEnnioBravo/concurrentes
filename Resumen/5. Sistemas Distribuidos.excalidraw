    {
      "id": "d1n7gfgvka",
      "type": "text",
      "x": 25,
      "y": 11996.75,
      "width": 1075.2,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
