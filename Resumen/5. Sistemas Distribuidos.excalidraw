      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Dos variantes al clonar:\n• app + base, SIN relación\n  (ej. un server por país)\n• solo la app, con base\n  COMPARTIDA (dibujo)",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dos variantes al clonar:\n• app + base, SIN relación\n  (ej. un server por país)\n• solo la app, con base\n  COMPARTIDA (dibujo)",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bA5"
    },
