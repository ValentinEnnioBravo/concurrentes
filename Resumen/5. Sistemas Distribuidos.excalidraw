      "isDeleted": false,
      "boundElements": [],
      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "JRuby: hilos del SO sin GIL → corren en\nparalelo. MRI: el GIL deja ejecutar a uno por\nproceso → hace falta un proceso por núcleo.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JRuby: hilos del SO sin GIL → corren en\nparalelo. MRI: el GIL deja ejecutar a uno por\nproceso → hace falta un proceso por núcleo.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b97"
    },
