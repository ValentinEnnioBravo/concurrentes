      "updated": 1795553583191,
      "link": null,
      "locked": false,
      "text": "Líder:   [1 x=5][2 y=3][3 x=x+1][4 borrar y]\nSeg. A:  [1 x=5][2 y=3][3 x=x+1][4 borrar y]  al día\nSeg. B:  [1 x=5][2 y=3]                       atrasado",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Líder:   [1 x=5][2 y=3][3 x=x+1][4 borrar y]\nSeg. A:  [1 x=5][2 y=3][3 x=x+1][4 borrar y]  al día\nSeg. B:  [1 x=5][2 y=3]                       atrasado",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCY"
    },
    {
      "id": "dzymx4h2w",
