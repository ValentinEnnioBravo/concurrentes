      "roundness": null,
      "seed": 1571,
      "version": 1,
      "versionNonce": 1572,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Ejecuta suponiendo que no habrá conflicto y VERIFICA AL FINAL si el trabajo\nsigue siendo válido. Ideal para operaciones CHICAS Y CORTAS sobre estado\ncompartido, donde un mutex agrega más complejidad de la que resuelve.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ejecuta suponiendo que no habrá conflicto y VERIFICA AL FINAL si el trabajo\nsigue siendo válido. Ideal para operaciones CHICAS Y CORTAS sobre estado\ncompartido, donde un mutex agrega más complejidad de la que resuelve.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g17p12gfsg",
      "type": "rectangle",
