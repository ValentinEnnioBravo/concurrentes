    },
    {
      "id": "g19s4kd6vq",
      "type": "text",
      "x": 25,
      "y": 6125.5,
      "width": 1097.6000000000001,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1649,
      "version": 1,
      "versionNonce": 1650,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "STM NO BLOQUEA las TVars durante la transacción: los otros threads pueden seguir leyéndolas y\nescribiéndolas, y el conflicto se detecta recién al confirmar. (GHC puede usar locks muy breves en\nel commit, pero la aplicación nunca toma locks.) Se puede re-ejecutar porque los cambios todavía\nestaban solo en memoria.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STM NO BLOQUEA las TVars durante la transacción: los otros threads pueden seguir leyéndolas y\nescribiéndolas, y el conflicto se detecta recién al confirmar. (GHC puede usar locks muy breves en\nel commit, pero la aplicación nunca toma locks.) Se puede re-ejecutar porque los cambios todavía\nestaban solo en memoria.",
      "autoResize": true,
      "lineHeight": 1.25
    },
