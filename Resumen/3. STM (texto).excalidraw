    },
    {
      "id": "g17sjqzmx9",
      "type": "text",
      "x": -160.4,
      "y": 5413.5,
      "width": 100.80000000000001,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
