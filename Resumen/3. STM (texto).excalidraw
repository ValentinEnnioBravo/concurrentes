      "link": null,
      "locked": false,
      "text": "La transacción puede re-ejecutarse y el efecto\nse repetiría; por tipos, STM no admite IO.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "La transacción puede re-ejecutarse y el efecto\nse repetiría; por tipos, STM no admite IO.",
      "autoResize": true,
      "lineHeight": 1.25
    },
