      "versionNonce": 1923,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Los dos tenedores se toman en un mismo\natomically: o agarra ambos o ninguno (retry).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Los dos tenedores se toman en un mismo\natomically: o agarra ambos o ninguno (retry).",
      "autoResize": true,
      "lineHeight": 1.25
    },
