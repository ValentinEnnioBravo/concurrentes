      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Pureza",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "gu1tld76g",
      "originalText": "Pureza",
