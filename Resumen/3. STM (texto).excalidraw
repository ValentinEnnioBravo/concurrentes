    },
    {
      "id": "g1csv4ocbq",
      "type": "text",
      "x": 20,
      "y": 6640.5,
      "width": 796.8,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1757,
      "version": 1,
      "versionNonce": 1758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "exec cont = do\n    hPutStr stdout \"Incrementando...\"\n    incTVar cont                  -- ERROR: es STM y este bloque es IO (no compila)\n\nexec cont = do\n    hPutStr stdout \"Incrementando...\"\n    atomically (incTVar cont)     -- OK: atomically lo convierte en IO\n\nmain = do\n    cont <- atomically (newTVar 3)\n    exec cont",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "exec cont = do\n    hPutStr stdout \"Incrementando...\"\n    incTVar cont                  -- ERROR: es STM y este bloque es IO (no compila)\n\nexec cont = do\n    hPutStr stdout \"Incrementando...\"\n    atomically (incTVar cont)     -- OK: atomically lo convierte en IO\n\nmain = do\n    cont <- atomically (newTVar 3)\n    exec cont",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g1cvb46ven",
