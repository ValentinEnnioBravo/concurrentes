    },
    {
      "id": "g17mlm8pu5",
      "type": "text",
      "x": 341,
      "y": 5290.5,
      "width": 756.0000000000001,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
