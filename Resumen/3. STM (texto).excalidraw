      "link": null,
      "locked": false
    },
    {
      "id": "g11yejjq3f",
      "type": "text",
      "x": 20,
      "y": 2740.5,
      "width": 883.1999999999999,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1367,
      "version": 1,
      "versionNonce": 1368,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "(<*>) :: f (a -> b) -> f a -> f b\npure  :: a -> f a                 -- para Maybe: pure 4 = Just 4\n\nJust (+3) <*> Just 2              -- Just 5\n(+) <$> Just 5 <*> Just 3         -- Just 8   (primero da Just (+5), después le aplica el 3)\n[(*2), (+3)] <*> [1, 2, 3]        -- [2,4,6,4,5,6]   (cada función con cada valor)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(<*>) :: f (a -> b) -> f a -> f b\npure  :: a -> f a                 -- para Maybe: pure 4 = Just 4\n\nJust (+3) <*> Just 2              -- Just 5\n(+) <$> Just 5 <*> Just 3         -- Just 8   (primero da Just (+5), después le aplica el 3)\n[(*2), (+3)] <*> [1, 2, 3]        -- [2,4,6,4,5,6]   (cada función con cada valor)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g121oq4t8f",
