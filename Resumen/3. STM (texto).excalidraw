      "versionNonce": 1500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "STM es otro MODELO DE CONCURRENCIA, distinto de los threads con locks y de las corrutinas. Ejecuta un\nbloque de operaciones sobre estado compartido como una TRANSACCIÓN: TODO O NADA, como la A de ACID en\nlas bases de datos.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "STM es otro MODELO DE CONCURRENCIA, distinto de los threads con locks y de las corrutinas. Ejecuta un\nbloque de operaciones sobre estado compartido como una TRANSACCIÓN: TODO O NADA, como la A de ACID en\nlas bases de datos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
