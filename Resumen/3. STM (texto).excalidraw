      "seed": 1766,
      "version": 1,
      "versionNonce": 1767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿Qué pasa si dos transacciones incrementan el mismo contador a la vez?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Qué pasa si dos transacciones incrementan el mismo contador a la vez?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
