    },
    {
      "id": "g11s4yrzdt",
      "type": "text",
      "x": 0,
      "y": 2635.5,
      "width": 1142.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1361,
      "version": 1,
      "versionNonce": 1362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "(+) <$> Just 5 da Just (+5): una FUNCIÓN DENTRO DE LA CAJA. fmap ya no alcanza para aplicársela a Just\n3, porque espera una función suelta. Applicative agrega <*> (desenvuelve la función, desenvuelve el\nvalor y aplica) y pure (mete un valor suelto en el contexto: lifting).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(+) <$> Just 5 da Just (+5): una FUNCIÓN DENTRO DE LA CAJA. fmap ya no alcanza para aplicársela a Just\n3, porque espera una función suelta. Applicative agrega <*> (desenvuelve la función, desenvuelve el\nvalor y aplica) y pure (mete un valor suelto en el contexto: lifting).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g11va8vgwm",
      "type": "rectangle",
      "x": 0,
      "y": 2725.5,
      "width": 1160,
      "height": 150,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1364,
      "version": 1,
      "versionNonce": 1365,
      "isDeleted": false,
      "boundElements": [],
