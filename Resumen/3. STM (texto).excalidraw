    {
      "id": "gxshbrlhk",
      "type": "text",
      "x": 0,
      "y": 1433,
      "width": 1086.4,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1217,
      "version": 1,
      "versionNonce": 1218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Un valor de tipo IO a es una ACCIÓN: la DESCRIPCIÓN de un efecto que, cuando el runtime de GHC la\nEJECUTA, produce un valor de tipo a. Evaluar putStrLn \"hola\" NO imprime: produce un IO () que se\nejecuta después.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un valor de tipo IO a es una ACCIÓN: la DESCRIPCIÓN de un efecto que, cuando el runtime de GHC la\nEJECUTA, produce un valor de tipo a. Evaluar putStrLn \"hola\" NO imprime: produce un IO () que se\nejecuta después.",
      "autoResize": true,
      "lineHeight": 1.25
    },
