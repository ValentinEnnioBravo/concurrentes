    {
      "id": "g14ghqexva",
      "type": "text",
      "x": 0,
      "y": 4123,
      "width": 1153.6000000000001,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1457,
      "version": 1,
      "versionNonce": 1458,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "MVar: variable mutable que puede estar LLENA o VACÍA. takeMVar saca el valor y BLOQUEA si está vacía;\nputMVar lo pone y BLOQUEA si está llena. Sirve para PASAR RESULTADOS entre threads y como LOCK. Es como\nuna promesa, pero bloquea hasta tener el valor.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MVar: variable mutable que puede estar LLENA o VACÍA. takeMVar saca el valor y BLOQUEA si está vacía;\nputMVar lo pone y BLOQUEA si está llena. Sirve para PASAR RESULTADOS entre threads y como LOCK. Es como\nuna promesa, pero bloquea hasta tener el valor.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g14joj1nwq",
      "type": "rectangle",
      "x": 0,
      "y": 4213,
      "width": 1160,
      "height": 190,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
