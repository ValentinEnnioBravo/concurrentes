      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Una confirma; la otra detecta que su lectura\nquedó vieja, descarta su log y reintenta con\nel valor nuevo.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Una confirma; la otra detecta que su lectura\nquedó vieja, descarta su log y reintenta con\nel valor nuevo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
