      "link": null,
      "locked": false,
      "text": "Si los conflictos son frecuentes, el trabajo descartado sale caro: conviene que las transacciones\nsean CORTAS.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Si los conflictos son frecuentes, el trabajo descartado sale caro: conviene que las transacciones\nsean CORTAS.",
      "autoResize": true,
      "lineHeight": 1.25
    },
