    {
      "id": "g1eyyrp7ji",
      "type": "text",
      "x": 20,
      "y": 7873,
      "width": 835.1999999999999,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1835,
      "version": 1,
      "versionNonce": 1836,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "transferir :: TVar Int -> TVar Int -> Int -> STM ()\ntransferir origen destino monto = do\n  saldo <- readTVar origen\n  check (saldo >= monto)               -- si no alcanza, espera a que cambie el saldo\n  writeTVar origen (saldo - monto)\n  modifyTVar' destino (+ monto)\n\nmain = do\n  origen  <- newTVarIO 100\n  destino <- newTVarIO 20\n  atomically (transferir origen destino 30)\n  saldos <- atomically ((,) <$> readTVar origen <*> readTVar destino)\n  print saldos                         -- (70,50): débito y crédito se confirman juntos",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "transferir :: TVar Int -> TVar Int -> Int -> STM ()\ntransferir origen destino monto = do\n  saldo <- readTVar origen\n  check (saldo >= monto)               -- si no alcanza, espera a que cambie el saldo\n  writeTVar origen (saldo - monto)\n  modifyTVar' destino (+ monto)\n\nmain = do\n  origen  <- newTVarIO 100\n  destino <- newTVarIO 20\n  atomically (transferir origen destino 30)\n  saldos <- atomically ((,) <$> readTVar origen <*> readTVar destino)\n  print saldos                         -- (70,50): débito y crédito se confirman juntos",
      "autoResize": true,
      "lineHeight": 1.25
    },
