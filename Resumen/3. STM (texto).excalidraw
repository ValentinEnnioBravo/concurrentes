      "text": "main :: IO ()\nmain = do\n  putStrLn \"¿Cómo te llamás?\"   -- :: IO ()\n  nombre <- getLine             -- :: IO String\n  putStrLn (\"Hola \" ++ nombre)  -- :: IO ()",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "main :: IO ()\nmain = do\n  putStrLn \"¿Cómo te llamás?\"   -- :: IO ()\n  nombre <- getLine             -- :: IO String\n  putStrLn (\"Hola \" ++ nombre)  -- :: IO ()",
      "autoResize": true,
      "lineHeight": 1.25
    },
