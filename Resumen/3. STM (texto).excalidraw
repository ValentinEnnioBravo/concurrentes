      "version": 1,
      "versionNonce": 1098,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Una estructura funcional se puede ver de dos formas: como CONTENEDOR (guarda valores) o como\nCOMPUTACIÓN (una función que la devuelve, que produce valores).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Una estructura funcional se puede ver de dos formas: como CONTENEDOR (guarda valores) o como\nCOMPUTACIÓN (una función que la devuelve, que produce valores).",
      "autoResize": true,
      "lineHeight": 1.25
    },
