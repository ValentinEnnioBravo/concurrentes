    {
      "id": "g1h4ygzv2v",
      "type": "text",
      "x": 420,
      "y": 8595.5,
      "width": 734.1600000000001,
      "height": 237.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1913,
      "version": 1,
      "versionNonce": 1914,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Cinco filósofos alrededor de una mesa, con UN TENEDOR ENTRE CADA PAR;\npara comer, cada uno necesita LOS DOS tenedores que tiene al lado.\n\n• Con LOCKS: si todos toman primero el izquierdo, quedan en DEADLOCK.\n\n• Con STM: cada tenedor es una TMVar (la versión transaccional de\n  MVar, vacía o llena). takeTMVar hace retry si está vacía. Tomar los\n  dos tenedores dentro de UN MISMO atomically hace que un filósofo\n  agarre AMBOS O NINGUNO: no hay deadlock porque nadie se queda con\n  uno solo esperando el otro.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cinco filósofos alrededor de una mesa, con UN TENEDOR ENTRE CADA PAR;\npara comer, cada uno necesita LOS DOS tenedores que tiene al lado.\n\n• Con LOCKS: si todos toman primero el izquierdo, quedan en DEADLOCK.\n\n• Con STM: cada tenedor es una TMVar (la versión transaccional de\n  MVar, vacía o llena). takeTMVar hace retry si está vacía. Tomar los\n  dos tenedores dentro de UN MISMO atomically hace que un filósofo\n  agarre AMBOS O NINGUNO: no hay deadlock porque nadie se queda con\n  uno solo esperando el otro.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g1h7alq6sg",
      "type": "text",
      "x": 20,
      "y": 8955.5,
      "width": 560,
      "height": 25,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1916,
      "version": 1,
      "versionNonce": 1917,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿Por qué con STM no hay deadlock en los filósofos?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué con STM no hay deadlock en los filósofos?",
      "autoResize": true,
      "lineHeight": 1.25
    },
