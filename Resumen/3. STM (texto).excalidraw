      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "class Monad m where\n    (>>=) :: m a -> (a -> m b) -> m b\n\nhalf x = if even x then Just (x `div` 2) else Nothing    -- devuelve un Maybe: no se le puede pasar Just 4 directo\n\nJust 4  >>= half      -- Just 2\nJust 3  >>= half      -- Nothing\nNothing >>= half      -- Nothing   (si el paso anterior falló, half ni se ejecuta)\n\ninstance Monad Maybe where\n    Nothing  >>= func = Nothing\n    Just val >>= func = func val",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Monad m where\n    (>>=) :: m a -> (a -> m b) -> m b\n\nhalf x = if even x then Just (x `div` 2) else Nothing    -- devuelve un Maybe: no se le puede pasar Just 4 directo\n\nJust 4  >>= half      -- Just 2\nJust 3  >>= half      -- Nothing\nNothing >>= half      -- Nothing   (si el paso anterior falló, half ni se ejecuta)\n\ninstance Monad Maybe where\n    Nothing  >>= func = Nothing\n    Just val >>= func = func val",
      "autoResize": true,
      "lineHeight": 1.25
    },
