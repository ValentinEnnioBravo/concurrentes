      "locked": false,
      "text": "Otro thread que lea los dos saldos dentro de una transacción ve el estado anterior o el posterior,\nNUNCA EL DÉBITO SIN EL CRÉDITO.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Otro thread que lea los dos saldos dentro de una transacción ve el estado anterior o el posterior,\nNUNCA EL DÉBITO SIN EL CRÉDITO.",
      "autoResize": true,
      "lineHeight": 1.25
    },
