      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "retry :: STM a\n\ncheck :: Bool -> STM ()\ncheck True  = return ()\ncheck False = retry\n\norElse :: STM a -> STM a -> STM a",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "retry :: STM a\n\ncheck :: Bool -> STM ()\ncheck True  = return ()\ncheck False = retry\n\norElse :: STM a -> STM a -> STM a",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g1edot718u",
