      "versionNonce": 1338,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Toda Monad es un Applicative y todo Applicative es un Functor. IO es una mónada, y STM también: así\nmaneja Haskell los efectos de forma compatible con funciones puras.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Toda Monad es un Applicative y todo Applicative es un Functor. IO es una mónada, y STM también: así\nmaneja Haskell los efectos de forma compatible con funciones puras.",
      "autoResize": true,
      "lineHeight": 1.25
    },
