    {
      "id": "g1hdlzkv41",
      "type": "text",
      "x": 1260,
      "y": 8965.5,
      "width": 453.6,
      "height": 45,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
