    {
      "id": "g14mx6a3k6",
      "type": "text",
      "x": 20,
      "y": 4228,
      "width": 921.5999999999999,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1463,
      "version": 1,
      "versionNonce": 1464,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "fibThread :: Int -> MVar Int -> IO ()\nfibThread n mvar = putMVar mvar (fib n)\n\nmain = do\n  fibResult <- newEmptyMVar\n  forkIO (fibThread 30 fibResult)      -- el cálculo corre en otro thread\n  a <- takeMVar fibResult              -- se bloquea hasta que el otro thread ponga el resultado\n  putStrLn (\"fib result: \" ++ show a)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "fibThread :: Int -> MVar Int -> IO ()\nfibThread n mvar = putMVar mvar (fib n)\n\nmain = do\n  fibResult <- newEmptyMVar\n  forkIO (fibThread 30 fibResult)      -- el cálculo corre en otro thread\n  a <- takeMVar fibResult              -- se bloquea hasta que el otro thread ponga el resultado\n  putStrLn (\"fib result: \" ++ show a)",
      "autoResize": true,
      "lineHeight": 1.25
    },
