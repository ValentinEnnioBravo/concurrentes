      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "¿Por qué IORef no alcanza con varios threads?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "¿Por qué IORef no alcanza con varios threads?",
      "autoResize": true,
      "lineHeight": 1.25
    },
