      "locked": false,
      "text": "IO y STM\nno se mezclan",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "g1cj8p1dpj",
      "originalText": "IO y STM\nno se mezclan",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g1cpqgvf7t",
      "type": "rectangle",
