      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Ordenar por timestamp FÍSICO no alcanza: si el reloj de B está atrasado, la RESPUESTA de B puede tener\nun timestamp MENOR que la PREGUNTA de A. No importa la hora, importa la CAUSALIDAD: qué evento PUDO\nHABER CAUSADO a cuál.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ordenar por timestamp FÍSICO no alcanza: si el reloj de B está atrasado, la RESPUESTA de B puede tener\nun timestamp MENOR que la PREGUNTA de A. No importa la hora, importa la CAUSALIDAD: qué evento PUDO\nHABER CAUSADO a cuál.",
      "autoResize": true,
      "lineHeight": 1.25
