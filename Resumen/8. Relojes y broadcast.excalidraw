    {
      "id": "gwvikhf74",
      "type": "text",
      "x": 620,
      "y": 968,
      "width": 297.59999999999997,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1184,
      "version": 1,
      "versionNonce": 1185,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "δ = (t4 − t1) − (t3 − t2)\n    demora de red ida y vuelta\n\nθ = (t2 − t1 + t3 − t4) / 2\n    desviación: cuánto corregir",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "δ = (t4 − t1) − (t3 − t2)\n    demora de red ida y vuelta\n\nθ = (t2 − t1 + t3 − t4) / 2\n    desviación: cuánto corregir",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gwy9ss1w2",
