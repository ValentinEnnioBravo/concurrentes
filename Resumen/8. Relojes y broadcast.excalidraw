    {
      "id": "g1emn0raij",
      "type": "text",
      "x": 25,
      "y": 5478,
      "width": 1030.4,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
