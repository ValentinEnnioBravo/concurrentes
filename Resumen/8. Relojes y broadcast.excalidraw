      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "L(a) = 3 y L(b) = 5. ¿a → b?\n¿Y si L(a) = 5 y L(b) = 3?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L(a) = 3 y L(b) = 5. ¿a → b?\n¿Y si L(a) = 5 y L(b) = 3?",
      "autoResize": true,
      "lineHeight": 1.25
    },
