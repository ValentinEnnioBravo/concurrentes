    {
      "id": "g1ranaety0",
      "type": "text",
      "x": 25,
      "y": 8024.25,
      "width": 1064,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2279,
      "version": 1,
      "versionNonce": 2280,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Trampa: orden total NO es más fuerte que causal (ni al revés): son garantías DISTINTAS. Total =\n\"todos igual\" sin respetar causas; causal = respeta causas pero los concurrentes pueden quedar\ndistinto en cada nodo. Lo que suma dos cosas es FIFO + total.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trampa: orden total NO es más fuerte que causal (ni al revés): son garantías DISTINTAS. Total =\n\"todos igual\" sin respetar causas; causal = respeta causas pero los concurrentes pueden quedar\ndistinto en cada nodo. Lo que suma dos cosas es FIFO + total.",
      "autoResize": true,
      "lineHeight": 1.25
    },
