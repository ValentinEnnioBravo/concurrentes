      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "evento local:     t := t + 1\nmandar m:         t := t + 1;  enviar (t, m)\nrecibir (t', m):  t := max(t, t') + 1",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "evento local:     t := t + 1\nmandar m:         t := t + 1;  enviar (t, m)\nrecibir (t', m):  t := max(t, t') + 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
