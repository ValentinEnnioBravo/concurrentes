      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Supuesto débil: la ida y la vuelta TARDAN LO MISMO (δ/2 cada una). Si la red es asimétrica, la\nestimación tiene error.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Supuesto débil: la ida y la vuelta TARDAN LO MISMO (δ/2 cada una). Si la red es asimétrica, la\nestimación tiene error.",
      "autoResize": true,
      "lineHeight": 1.25
    },
