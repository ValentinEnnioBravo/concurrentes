    },
    {
      "id": "gx1pvxt4x",
      "type": "text",
      "x": 20,
      "y": 1178,
      "width": 1017.5999999999999,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1190,
      "version": 1,
      "versionNonce": 1191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "Ej.: t1 = 100, t2 = 150, t3 = 152, t4 = 110\nδ = (110 − 100) − (152 − 150) = 8      θ = (150 − 100 + 152 − 110) / 2 = 46  → el cliente está 46 ATRASADO",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ej.: t1 = 100, t2 = 150, t3 = 152, t4 = 110\nδ = (110 − 100) − (152 − 150) = 8      θ = (150 − 100 + 152 − 110) / 2 = 46  → el cliente está 46 ATRASADO",
      "autoResize": true,
      "lineHeight": 1.25
    },
