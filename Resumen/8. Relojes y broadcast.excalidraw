      "link": null,
      "locked": false,
      "text": "Hay pares que NO se pueden comparar (los\nconcurrentes). Un orden total es CAUSAL si nunca\npone un efecto antes de su causa.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hay pares que NO se pueden comparar (los\nconcurrentes). Un orden total es CAUSAL si nunca\npone un efecto antes de su causa.",
      "autoResize": true,
      "lineHeight": 1.25
    },
