    {
      "id": "g1adse2xt8",
      "type": "text",
      "x": 0,
      "y": 4715.5,
      "width": 1131.2,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1670,
      "version": 1,
      "versionNonce": 1671,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "En vez de UN número, cada nodo lleva UN CONTADOR POR CADA NODO: ⟨A, B, C⟩. T[i] = cuántos eventos del\nnodo i \"conoce\" este evento. Al recibir: MÁXIMO POSICIÓN A POSICIÓN (como el merge del G-Counter) y\nsumo 1 en MI posición.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En vez de UN número, cada nodo lleva UN CONTADOR POR CADA NODO: ⟨A, B, C⟩. T[i] = cuántos eventos del\nnodo i \"conoce\" este evento. Al recibir: MÁXIMO POSICIÓN A POSICIÓN (como el merge del G-Counter) y\nsumo 1 en MI posición.",
      "autoResize": true,
      "lineHeight": 1.25
    },
