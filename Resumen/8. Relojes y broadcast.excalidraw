      "boundElements": [],
      "updated": 1795491565091,
      "link": null,
      "locked": false,
      "text": "NTP sincroniza relojes por red: cada máquina ESTIMA CUÁNTO SE DESVÍA de un servidor más preciso y\nCORRIGE. Preciso, pero NO perfecto (pocos ms en buena red, puede ser peor).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NTP sincroniza relojes por red: cada máquina ESTIMA CUÁNTO SE DESVÍA de un servidor más preciso y\nCORRIGE. Preciso, pero NO perfecto (pocos ms en buena red, puede ser peor).",
      "autoResize": true,
      "lineHeight": 1.25
    },
