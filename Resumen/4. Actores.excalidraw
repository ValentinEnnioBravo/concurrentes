    {
      "id": "dPF3A4Bfcw5gOPiMdoxqG",
      "type": "text",
      "x": 4438.763532366076,
      "y": 5148.711164449857,
      "width": 1165.13916015625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3f",
      "roundness": null,
      "seed": 129256549,
      "version": 204,
      "versionNonce": 1658735563,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795481719667,
      "link": null,
      "locked": false,
      "text": "Con spawn, cuando un proceso falla el proceso padre sigue ejecutandose. Esto ocurre porque los procesos son aislados.\nPara que el error se propague hay que linkearlos.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con spawn, cuando un proceso falla el proceso padre sigue ejecutandose. Esto ocurre porque los procesos son aislados.\nPara que el error se propague hay que linkearlos.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
