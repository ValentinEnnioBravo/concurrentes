      "link": null,
      "locked": false,
      "text": "Nodo BEAM, corre MiApp.Application.start/2 como entrada\n--- Supervisor, arranca todo, si algo crashea reinicia, NO interviene en requests",
      "fontSize": 20.207541190755364,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nodo BEAM, corre MiApp.Application.start/2 como entrada\n--- Supervisor, arranca todo, si algo crashea reinicia, NO interviene en requests",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
